+#include <QTcpServer>
+#include <QTimer>
+#include <QUrl>
+#include <functional>
+class QWidget;
+
+class DirectorMediaPeer final : public QObject {
+public:
+    using Receive=std::function<void(const QUrl &,bool,const QJsonObject &)>;
+    struct Effects {
+        std::function<bool(QWidget *,const QUrl &,Receive)> create;
+        std::function<void(const QJsonObject &)> command;
+        std::function<void()> stop;
+    };
+    explicit DirectorMediaPeer(QObject *parent=nullptr);
+    ~DirectorMediaPeer();
+    bool SetEffects(Effects effects);
+    bool Prepare(QWidget *host,const QString &generation);
+    void Answer(const QString &generation,const QString &sdp);
+    void Capture(const QString &generation);
+    void Mute(bool muted);
+    void Stop();
+    bool Listening() const { return capturing && !muted; }
+    bool Capturing() const { return capturing; }
+    bool Negotiated() const { return ready; }
+    bool Muted() const { return muted; }
+    bool Active() const { return !generation.isEmpty(); }
+    void ReceiveMessage(const QUrl &origin,bool mainFrame,const QJsonObject &message);
+    std::function<void(const QString &,const QString &)> offered;
+    std::function<void(const QString &)> negotiated;
+    std::function<void()> failed,changed;
+    static bool ValidSdp(const QString &sdp);
+    static QByteArray Page();
+private:
+    Effects effects;
+    QTcpServer server;
+    QTimer deadline;
+    QUrl pageUrl;
+    QString generation;
+    bool offeredOnce=false,answered=false,ready=false,captureRequested=false,capturing=false,muted=false;
+    void Fail();
+    void Command(const QString &type,const QString &sdp={});
+};
+DirectorMediaPeer::Effects DirectorPlatformMediaEffects();
