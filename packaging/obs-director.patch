+// SPDX-License-Identifier: GPL-2.0-or-later
+#import <WebKit/WebKit.h>
+#import <AppKit/AppKit.h>
+#include "DirectorMediaPeer.hpp"
+#include <QWidget>
+#include <QJsonDocument>
+#include <memory>
+
+@interface DirectorMediaDelegate : NSObject <WKScriptMessageHandler,WKNavigationDelegate,WKUIDelegate> {
+@public
+    DirectorMediaPeer::Receive receive;
+    QUrl page;
+    QString generation;
+    BOOL captureAllowed;
+    BOOL navigationSeen;
+}
+@end
+@implementation DirectorMediaDelegate
+- (void)fail {
+    if(receive)receive(page,true,{{"type","error"},{"generation",generation}});
+}
+- (void)userContentController:(WKUserContentController *)controller didReceiveScriptMessage:(WKScriptMessage *)message {
+    (void)controller;
+    WKSecurityOrigin *origin=message.frameInfo.securityOrigin;
+    if(!message.frameInfo.isMainFrame || ![origin.protocol isEqualToString:@"http"] || ![origin.host isEqualToString:@"127.0.0.1"] || origin.port!=page.port() || QUrl(QString::fromUtf8(message.frameInfo.request.URL.absoluteString.UTF8String))!=page){[self fail];return;}
+    if(![message.body isKindOfClass:[NSDictionary class]] || ![NSJSONSerialization isValidJSONObject:message.body]){[self fail];return;}
+    NSData *bytes=[NSJSONSerialization dataWithJSONObject:message.body options:0 error:nil];
+    if(!bytes || bytes.length>65536){[self fail];return;}
+    const auto body=QJsonDocument::fromJson(QByteArray(static_cast<const char *>(bytes.bytes),bytes.length)).object();
+    const auto url=QUrl(QString::fromUtf8(message.frameInfo.request.URL.absoluteString.UTF8String));
+    if(receive)receive(url,message.frameInfo.isMainFrame,body);
+}
+- (void)webView:(WKWebView *)webView decidePolicyForNavigationAction:(WKNavigationAction *)action decisionHandler:(void (^)(WKNavigationActionPolicy))decisionHandler {
+    (void)webView;
+    const auto url=QUrl(QString::fromUtf8(action.request.URL.absoluteString.UTF8String));
+    const bool allowed=!navigationSeen && action.targetFrame.isMainFrame && url==page;
+    if(allowed)navigationSeen=YES;
+    decisionHandler(allowed ? WKNavigationActionPolicyAllow : WKNavigationActionPolicyCancel);
+    if(!allowed)[self fail];
+}
+- (void)webView:(WKWebView *)webView decidePolicyForNavigationResponse:(WKNavigationResponse *)response decisionHandler:(void (^)(WKNavigationResponsePolicy))decisionHandler {
+    (void)webView;
+    const bool allowed=response.isForMainFrame && response.canShowMIMEType && [response.response.MIMEType isEqualToString:@"text/html"];
+    decisionHandler(allowed ? WKNavigationResponsePolicyAllow : WKNavigationResponsePolicyCancel);
+    if(!allowed)[self fail];
+}
+- (WKWebView *)webView:(WKWebView *)webView createWebViewWithConfiguration:(WKWebViewConfiguration *)configuration forNavigationAction:(WKNavigationAction *)action windowFeatures:(WKWindowFeatures *)features {
+    (void)webView;(void)configuration;(void)action;(void)features;[self fail];return nil;
+}
+- (void)webView:(WKWebView *)webView requestMediaCapturePermissionForOrigin:(WKSecurityOrigin *)origin initiatedByFrame:(WKFrameInfo *)frame type:(WKMediaCaptureType)type decisionHandler:(void (^)(WKPermissionDecision))decisionHandler {
+    (void)webView;
+    const bool allowed=captureAllowed && type==WKMediaCaptureTypeMicrophone && frame.isMainFrame &&
+        QUrl(QString::fromUtf8(frame.request.URL.absoluteString.UTF8String))==page &&
+        [origin.protocol isEqualToString:@"http"] && [origin.host isEqualToString:@"127.0.0.1"] && origin.port==page.port();
+    decisionHandler(allowed ? WKPermissionDecisionPrompt : WKPermissionDecisionDeny);
+}
+- (void)webViewWebContentProcessDidTerminate:(WKWebView *)webView {(void)webView;[self fail];}
+- (void)webView:(WKWebView *)webView didFailNavigation:(WKNavigation *)navigation withError:(NSError *)error {(void)webView;(void)navigation;(void)error;[self fail];}
+- (void)webView:(WKWebView *)webView didFailProvisionalNavigation:(WKNavigation *)navigation withError:(NSError *)error {(void)webView;(void)navigation;(void)error;[self fail];}
+@end
+
+struct DirectorWKPeer {
+    WKWebView *view=nil;
+    DirectorMediaDelegate *delegate=nil;
+    void Stop() {
+        if(delegate){delegate->captureAllowed=NO;delegate->receive={};}
+        if(view){
+            [view setMicrophoneCaptureState:WKMediaCaptureStateNone completionHandler:nil];
+            [view setAllMediaPlaybackSuspended:YES completionHandler:nil];
+            [view stopLoading];[view.configuration.userContentController removeScriptMessageHandlerForName:@"directorMedia"];
+            view.navigationDelegate=nil;view.UIDelegate=nil;[view removeFromSuperview];
+        }
+        view=nil;delegate=nil;
+    }
+    ~DirectorWKPeer(){Stop();}
+};
+DirectorMediaPeer::Effects DirectorPlatformMediaEffects()
+{
+    auto state=std::make_shared<DirectorWKPeer>();
+    DirectorMediaPeer::Effects effects;
+    effects.create=[state](QWidget *host,const QUrl &url,auto receive){
+        if(!host || state->view)return false;
+        auto configuration=[WKWebViewConfiguration new];configuration.websiteDataStore=[WKWebsiteDataStore nonPersistentDataStore];
+        configuration.mediaTypesRequiringUserActionForPlayback=WKAudiovisualMediaTypeNone;
+        configuration.preferences.javaScriptCanOpenWindowsAutomatically=NO;
+        state->delegate=[DirectorMediaDelegate new];state->delegate->receive=receive;state->delegate->page=url;
+        [configuration.userContentController addScriptMessageHandler:state->delegate name:@"directorMedia"];
+        NSView *container=(__bridge NSView *)(void *)host->winId();
+        state->view=[[WKWebView alloc] initWithFrame:container.bounds configuration:configuration];
+        state->view.autoresizingMask=NSViewWidthSizable|NSViewHeightSizable;
+        state->view.navigationDelegate=state->delegate;state->view.UIDelegate=state->delegate;
+        [container addSubview:state->view];
+        [state->view loadRequest:[NSURLRequest requestWithURL:[NSURL URLWithString:[NSString stringWithUTF8String:url.toEncoded().constData()]]]];
+        return true;
+    };
+    effects.command=[state](const QJsonObject &command){
+        if(!state->view || !state->delegate)return;
+        state->delegate->generation=command.value("generation").toString();
+        if(command.value("type")=="capture")state->delegate->captureAllowed=YES;
+        if(command.value("type")=="stop")state->delegate->captureAllowed=NO;
+        const auto bytes=QJsonDocument(command).toJson(QJsonDocument::Compact);
+        NSDictionary *argument=[NSJSONSerialization JSONObjectWithData:[NSData dataWithBytes:bytes.constData() length:bytes.size()] options:0 error:nil];
+        __weak DirectorMediaDelegate *delegate=state->delegate;
+        [state->view callAsyncJavaScript:@"return await window.directorPeer(command)" arguments:@{@"command":argument} inFrame:nil inContentWorld:WKContentWorld.pageWorld completionHandler:^(id result,NSError *error){(void)result;if(error)[delegate fail];}];
+    };
+    effects.stop=[state]{state->Stop();};return effects;
+}
