+inline void directorSessionChecks()
+{
+	// This sentinel is created by the test, not read from private environment.
+	qputenv("DIRECTOR_TEST_SENTINEL","must-not-inherit");
+    for (const auto &mode : {"chatgpt","signed-out","api-key","invalid","overflow","die","request","hang","hold","weak-policy","provider-error","model-error","auth-loss"}) {
+        QTemporaryDir project(QDir::tempPath()+"/director-panel-"+mode+"-XXXXXX");
+        QDir().mkpath(project.path()+"/.venv/bin");
+        QFile marker(project.path()+"/director_mcp.py"); check(marker.open(QIODevice::WriteOnly),"create fake MCP marker"); marker.close();
+        check(QFile::link(QCoreApplication::applicationFilePath(),project.path()+"/.venv/bin/python"),"fake project executable fixture");
+        const auto config=project.path()+"/application-config";
+        DirectorSession session; int opened=0;
+        session.openSignIn=[&](const QUrl &url) { ++opened; return url.host()=="auth.openai.com"; }; // Never invokes a browser.
+        auto connect=[&] { session.Connect(QCoreApplication::applicationFilePath(),project.path(),8880,config); };
+        connect();
+        const QString name=mode;
+        if (name=="chatgpt" || name=="signed-out" || name=="hold" || name=="weak-policy" || name=="provider-error" || name=="model-error" || name=="auth-loss") {
+            check(waitFor([&] { return session.Connected(); }),"fake stdio initialization and auth read");
+            check(opened==0,"connecting never starts sign-in");
+            if (name=="signed-out") {
+                check(waitFor([&] { return session.CanSignIn(); }),"auth read completes before explicit sign-in");
+                check(!session.Submit("Not authenticated"),"signed-out turn refused");
+                session.SignIn(); check(waitFor([&] { return session.CanSubmit(); }),"explicit managed subscription sign-in lifecycle");
+                check(opened==1,"only explicit sign-in opens managed URL through injected test handler");
+            }
+            check(waitFor([&] { return session.CanSubmit(); }),"subscription client allows real operator submission");
+            check(session.Submit("Create an original lower band composition"),"actual turn request accepted by adapter");
