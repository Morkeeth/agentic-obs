+void DirectorPanel::Update()
+{
+    voiceStart->setEnabled(voiceOptIn->isChecked() && session.CanSubmit());
+    voiceStop->setEnabled(session.VoiceBusy());voiceMute->setEnabled(voicePeer.Negotiated());
+    {const QSignalBlocker block(voiceMute);voiceMute->setChecked(voicePeer.Muted());}
+    voiceStatus->setText(session.VoiceStatus()+(voicePeer.Capturing() ? (voicePeer.Listening() ? " Listening." : " Microphone muted.") : "")+"\n"+voiceConsentStatus);
+	sessionStatus->setText(session.Status());
+	signIn->setEnabled(session.CanSignIn());
+	// Conversation remains editable; only native mutation/review requires fresh show state.
+	const bool author = session.CanSubmit();
+	input->setEnabled(author); submit->setEnabled(author);
+	if (conversation->toPlainText() != session.Transcript()) {
+		conversation->setPlainText(session.Transcript());
+		auto cursor = conversation->textCursor(); cursor.movePosition(QTextCursor::End); conversation->setTextCursor(cursor);
+	}
+	const bool finished = wasWorking && !session.Working();
+	wasWorking = session.Working();
+	if (finished && (!session.VoiceBusy() || session.VoiceActive())) controller.Refresh();
+	const auto state = controller.State();
+	const auto version = state.value("version").toInteger(-1);
+	const auto identity = state.value("native_review").toObject();
+	if (version != shownVersion || identity != shownReview || !controller.Fresh() || !operatorSetup->Ready() || operatorSetup->Version()!=version || !state.value("armed").toBool() || !state.value("obs").toObject().value("connected").toBool() || state.value("paused").toBool() || !state.value("rendered_ready").toBool() || state.value("destination")!="obs" || session.Working() || (session.VoiceBusy() && !voicePeer.Negotiated()) || (spokenBinding.Bound() && (!spokenBinding.Armed(voiceClock.elapsed()) || !voicePeer.Listening()))) {
+		const QSignalBlocker block(reviewed); reviewed->setChecked(false); spokenBinding.Clear();
+	}
+    if(version!=shownVersion || identity!=shownReview || !voicePeer.Listening())spokenBinding.Clear();
+	shownVersion = version; shownReview = identity;
+	const bool native = operatorSetup->Ready() && operatorSetup->Version()==version && controller.Ready() && state.value("armed").toBool() && state.value("obs").toObject().value("connected").toBool() && !state.value("paused").toBool();
+	const bool exact = native && !session.Working() && (!session.VoiceBusy() || voicePeer.Negotiated()) && !shownReview.isEmpty() && state.value("destination") == "obs" && state.value("rendered_ready").toBool();
+	showStatus->setText(controller.Status() + QStringLiteral("\nVersion %1 · stage %2 · preview bank %3 · agent approval %4")
+		.arg(version).arg(state.value("stage_id").toInteger(-1)).arg(state.value("prepared_bank").toString("none"))
+		.arg(state.value("agent_take_approved").toBool() ? "present" : "absent"));
+	reviewed->setEnabled(exact);
+    spokenReview->setEnabled(true); // One-time opt-in, independent of changing previews.
+    if(exact && voicePeer.Listening())showStatus->setText(showStatus->text()+QStringLiteral("\nHuman must inspect and click the exact reviewed checkbox first. Then say: take preview %1 revision %2 (up to 8s). %3. Fully hands-free authorization OPEN")
+        .arg(identity.value("payload_id").toInteger(-1)).arg(version).arg(spokenBinding.Armed(voiceClock.elapsed()) ? "Human arm active" : "Human arm required"));
+	preview->setEnabled(native);
+	take->setEnabled(exact && reviewed->isChecked());
+	approve->setEnabled(exact && reviewed->isChecked());
+	undo->setEnabled(native && state.value("can_undo_camera_layout").toBool());
+	recover->setEnabled(native && state.value("can_restore").toBool());
+	cancel->setEnabled(session.Busy());
+    cancelPreparation->setEnabled(operatorSetup->CanCancel());
+}
