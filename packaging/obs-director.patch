+#include <QSlider>
+#include <QVBoxLayout>
+#include <QScrollArea>
+
+DirectorShell::DirectorShell(QMainWindow *window, std::function<void()> enableStudio, const QString &runtimeConfig, std::function<DirectorObsProfile()> ownProfile)
+	: QDockWidget(QStringLiteral("Codex Director"), window), window(window), enableStudio(enableStudio)
+{
+	setObjectName(QStringLiteral("codexDirectorDock"));
+	setMinimumWidth(300);
+	auto panel = new QWidget(this);
+	auto layout = new QVBoxLayout(panel);
+	directorPanel = new DirectorPanel(panel,runtimeConfig,ownProfile);
+	layout->addWidget(directorPanel);
+	auto advancedButton = new QPushButton(QStringLiteral("Advanced view / return to Director mode"), panel);
+	layout->addWidget(advancedButton);
+	setWidget(panel);
+
+	for (auto action : window->findChildren<QAction *>()) {
+		ordinaryMenus.append(action);
+		menuVisibility.append(action->isVisible());
+	}
+	auto menu = window->menuBar()->addMenu(QStringLiteral("Director"));
+	advancedAction = menu->addAction(QStringLiteral("Advanced view — manual setup / recovery"));
+	advancedAction->setCheckable(true);
+	connect(advancedAction, &QAction::triggered, this, [this](bool checked) { SetAdvanced(checked); });
+	auto normal = menu->addAction(QStringLiteral("Return to Director mode"));
+	connect(normal, &QAction::triggered, this, [this] { SetAdvanced(false); });
+	connect(advancedButton, &QPushButton::clicked, this, [this] { SetAdvanced(!advanced); });
+	window->addDockWidget(Qt::RightDockWidgetArea, this);
+	// Enforce normal mode even after a saved layout, dock reset, plugin dock show,
+	// or a shortcut. Never overwrite the saved OBS dock-state configuration.
+	qApp->installEventFilter(this);
+	SetAdvanced(false);
+}
+
+void DirectorShell::ApplyDirectorLayout()
+{
+	if (applying || advanced)
+		return;
+	applying = true;
+	for (auto dock : window->findChildren<QDockWidget *>()) {
+		if (dock != this)
+			dock->hide();
+	}
+	setFloating(false);
+	window->addDockWidget(Qt::RightDockWidgetArea, this);
+	setFeatures(QDockWidget::NoDockWidgetFeatures);
+	show();
+	raise();
+	applying = false;
+}
+
+void DirectorShell::SetAdvanced(bool value)
+{
+	if (value && !advanced) {
+		advanced = true; // Allow show events while restoring the operator workspace.
+		if (!advancedLayout.isEmpty())
+			window->restoreState(advancedLayout);
+		else
+			for (auto dock : window->findChildren<QDockWidget *>())
+				if (dock != this)
+					dock->show();
+		// A prior Director-mode save legitimately has every legacy dock hidden.
+		// Ensure the core manual setup controls are recoverable on first entry.
+		for (const char *name : {"scenesDock", "sourcesDock", "mixerDock", "transitionsDock", "controlsDock"})
+			if (auto dock = window->findChild<QDockWidget *>(QString::fromLatin1(name)))
+				dock->show();
+		setFeatures(QDockWidget::DockWidgetMovable | QDockWidget::DockWidgetFloatable);
+		show();
+	} else if (!value) {
+		if (advanced || advancedLayout.isEmpty())
+			advancedLayout = window->saveState();
+		advanced = false;
+		enableStudio();
+		ApplyDirectorLayout();
+	}
+	if (auto toolbar = window->findChild<QWidget *>(QStringLiteral("contextContainer")))
+		toolbar->setVisible(advanced);
+	if (auto options = window->findChild<QWidget *>(QStringLiteral("directorLegacyTransitions")))
+		options->setVisible(advanced);
+	directorPanel->SetAdvanced(advanced);
+	advancedAction->setChecked(advanced);
+	for (int i = 0; i < ordinaryMenus.size(); ++i)
+		if (ordinaryMenus[i])
+			ordinaryMenus[i]->setVisible(advanced && menuVisibility[i]);
+}
+
+bool DirectorShell::eventFilter(QObject *object, QEvent *event)
+{
+	if (!advanced && !applying) {
+		auto dock = qobject_cast<QDockWidget *>(object);
+		if (dock && dock != this && window->isAncestorOf(dock) &&
+		    (event->type() == QEvent::Show || event->type() == QEvent::ShowToParent)) {
+			dock->hide();
+			return true;
+		}
+		auto widget = qobject_cast<QWidget *>(object);
+		if (widget && widget->objectName() == "directorLegacyTransitions" && window->isAncestorOf(widget) &&
+		    (event->type() == QEvent::Show || event->type() == QEvent::ShowToParent)) {
+			widget->hide(); return true;
+		}
+		if (object == window && event->type() == QEvent::ContextMenu)
+			return true; // No legacy dock-toggle popup in Director mode.
+	}
+	return QDockWidget::eventFilter(object, event);
+}
+
+bool DirectorShell::RefuseOutputStart(const char *output)
+{
+	// Unconditional fork-demo policy: no setting, UI toggle or environment bypass.
+	// Stops remain in the original OBS paths. Do not move this behind auth/setup.
+	qWarning("Codex Director demo: %s frontend start refused", output);
+	return true;
+}
