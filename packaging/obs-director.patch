+R"DIRECTOR(<!doctype html><meta charset="utf-8"><title>Private Director voice</title>
+<body><span>Private voice media</span><audio id="reply" autoplay></audio><script nonce="DIRECTOR_NONCE">
+'use strict';
+(() => {
+ let generation='', pc=null, channel=null, transceiver=null, stream=null, retired=false, answer=false, captureRequested=false, capturing=false, captureEpoch=0;
+ const player=document.getElementById('reply'); player.muted=true;
+ const send=(type,fields={})=>window.webkit.messageHandlers.directorMedia.postMessage({type,generation,...fields});
+ const stop=()=>{retired=true;++captureEpoch;capturing=false; if(stream)stream.getTracks().forEach(t=>t.stop());stream=null;
+   if(pc)pc.close();pc=null;if(channel)channel.close();channel=null;player.pause();player.srcObject=null;};
+ const fail=()=>{stop();send('error');};
+ const alive=p=>!retired && p===pc;
+ window.addEventListener('pagehide',stop);
+ window.directorPeer=async command=>{
+   if(!command || typeof command.generation!=='string')return;
+   if(command.type==='prepare') {
+     if(pc || retired || !window.isSecureContext || !window.RTCPeerConnection){generation=command.generation;fail();return;}
+     generation=command.generation;
+     const p=pc=new RTCPeerConnection({iceServers:[]});
+     transceiver=p.addTransceiver('audio',{direction:'sendrecv'});
+     channel=p.createDataChannel('oai-events');
+     // Media-only ingress. No arbitrary client events or text injection; incoming data stays unparsed.
+     channel.onmessage=()=>{};channel.onerror=fail;
+     p.ondatachannel=e=>{e.channel.close();fail();};
+     p.ontrack=e=>{if(alive(p)){player.srcObject=new MediaStream([e.track]);if(capturing){player.muted=false;player.play().catch(()=>{if(alive(p))fail();});}}};
+     p.onconnectionstatechange=()=>{if(alive(p) && ['failed','disconnected','closed'].includes(p.connectionState))fail();};
+     try {
+       await p.setLocalDescription(await p.createOffer());if(!alive(p))return;
+       if(p.iceGatheringState!=='complete')await new Promise((resolve,reject)=>{
+         const timer=setTimeout(()=>{p.removeEventListener('icegatheringstatechange',change);reject(new Error('ice'));},5000);
+         const change=()=>{if(p.iceGatheringState==='complete'){clearTimeout(timer);p.removeEventListener('icegatheringstatechange',change);resolve();}};
+         p.addEventListener('icegatheringstatechange',change);change();
+       });
+       if(alive(p))send('offer',{sdp:p.localDescription.sdp});
+     } catch {if(alive(p))fail();}
+     return;
+   }
+   if(command.generation!==generation || retired)return;
+   const p=pc;
+   if(command.type==='stop'){stop();return;}
+   if(command.type==='answer') {
+     if(answer || !p || typeof command.sdp!=='string'){fail();return;}
+     answer=true;
+     try {await p.setRemoteDescription({type:'answer',sdp:command.sdp});if(alive(p))send('negotiated');} catch {if(alive(p))fail();}
+   } else if(command.type==='capture' || command.type==='unmute') {
+     if(!answer || !p || captureRequested){fail();return;}captureRequested=true;const epoch=++captureEpoch;
+     try {
+       const media=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true},video:false});
+       if(!alive(p) || epoch!==captureEpoch){media.getTracks().forEach(t=>t.stop());return;}
+       stream=media;const tracks=media.getAudioTracks();
+       if(tracks.length!==1){fail();return;}tracks[0].onended=fail;
+       await transceiver.sender.replaceTrack(tracks[0]);if(!alive(p) || epoch!==captureEpoch){media.getTracks().forEach(t=>t.stop());return;}
+       capturing=true;send('capturing');if(player.srcObject){player.muted=false;player.play().catch(()=>{if(alive(p))fail();});}
+     } catch {if(alive(p))fail();}
+   } else if(command.type==='mute') {
+     ++captureEpoch;capturing=false;captureRequested=false;player.muted=true;player.pause();
+     if(stream)stream.getTracks().forEach(t=>t.stop());stream=null;
+     if(transceiver)await transceiver.sender.replaceTrack(null);
+   } else fail();
+ };
+ send('loaded');
+})();
+</script></body>)DIRECTOR"
diff --git a/frontend/widgets/DirectorMediaPeer.cpp b/frontend/widgets/DirectorMediaPeer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..66d41090439688e10a96736ea48b3d57f2a6a46d
--- /dev/null
+++ b/frontend/widgets/DirectorMediaPeer.cpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "DirectorMediaPeer.hpp"
+#include <QTcpSocket>
+#include <QJsonDocument>
+#include <QUuid>
+#include <QPointer>
+
+QByteArray DirectorMediaPeer::Page(){return QByteArray(
+#include "DirectorMediaPage.inc"
+);}
+DirectorMediaPeer::DirectorMediaPeer(QObject *parent):QObject(parent),effects(DirectorPlatformMediaEffects())
+{
+    server.setMaxPendingConnections(4);
+    deadline.setSingleShot(true);
+    QObject::connect(&deadline,&QTimer::timeout,this,[this]{Fail();});
+    QObject::connect(&server,&QTcpServer::newConnection,this,[this]{
+        while(server.hasPendingConnections()) {
+            auto socket=server.nextPendingConnection();socket->setReadBufferSize(8193);
+            if(server.findChildren<QTcpSocket *>().size()>4){socket->abort();socket->deleteLater();continue;}
+            const auto serial=generation;
+            QTimer::singleShot(2000,socket,[socket]{socket->abort();});
+            QObject::connect(socket,&QTcpSocket::disconnected,socket,&QObject::deleteLater);
+            QObject::connect(socket,&QTcpSocket::readyRead,this,[this,socket,serial]{
+                auto bytes=socket->property("request").toByteArray()+socket->readAll();
+                if(bytes.size()>8192 || serial!=generation || !socket->peerAddress().isLoopback()){socket->abort();return;}
+                socket->setProperty("request",bytes);
+                if(!bytes.contains("\r\n\r\n"))return;
+                const auto expected="GET "+pageUrl.path().toUtf8()+" HTTP/1.1";
+                const auto host="host: 127.0.0.1:"+QByteArray::number(server.serverPort());
+                bool hostOk=false;for(auto line:bytes.split('\n'))if(line.trimmed().toLower()==host)hostOk=true;
+                if(bytes.split('\r').value(0)!=expected || !hostOk || bytes.indexOf("\r\n\r\n")+4!=bytes.size()){socket->abort();return;}
+                const auto nonce=pageUrl.path().mid(1).toUtf8();
+                auto page=Page();page.replace("DIRECTOR_NONCE",nonce);
+                const auto headers="HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nPermissions-Policy: microphone=(self), camera=()\r\nContent-Security-Policy: default-src 'none'; script-src 'nonce-"+nonce+"'; media-src blob:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'\r\nConnection: close\r\nContent-Length: "+QByteArray::number(page.size())+"\r\n\r\n";
+                socket->write(headers+page);socket->disconnectFromHost();
+            });
+        }
+    });
+}
+DirectorMediaPeer::~DirectorMediaPeer(){failed={};changed={};Stop();}
+bool DirectorMediaPeer::SetEffects(Effects value){if(Active())return false;effects=std::move(value);return true;}
+bool DirectorMediaPeer::ValidSdp(const QString &sdp)
+{
+    if(!sdp.startsWith("v=0\r\n") || sdp.size()>49152 || !sdp.contains("\r\nm=audio "))return false;
+    for(const auto c:sdp)if((c.unicode()<32 && c!='\r' && c!='\n') || c.unicode()>126)return false;
+    return true;
+}
+bool DirectorMediaPeer::Prepare(QWidget *host,const QString &serial)
+{
+    if(Active() || serial.isEmpty() || serial.size()>64)return false;
+    generation=serial;
+    if(!server.listen(QHostAddress::LocalHost,0)){Fail();return false;}
+    pageUrl=QUrl(QStringLiteral("http://127.0.0.1:%1/%2").arg(server.serverPort()).arg(QUuid::createUuid().toString(QUuid::WithoutBraces)));
+    QPointer<DirectorMediaPeer> guard(this);
+    if(!effects.create || !effects.create(host,pageUrl,[guard,serial](const QUrl &url,bool main,const QJsonObject &body){if(guard && guard->generation==serial)guard->ReceiveMessage(url,main,body);})){Fail();return false;}
+    deadline.start(8000);return true;
+}
+void DirectorMediaPeer::Command(const QString &type,const QString &sdp)
+{
+    QJsonObject command{{"type",type},{"generation",generation}};if(!sdp.isEmpty())command.insert("sdp",sdp);
+    if(effects.command)effects.command(command);else Fail();
+}
+void DirectorMediaPeer::ReceiveMessage(const QUrl &url,bool main,const QJsonObject &body)
+{
+    if(!Active())return;
+    const auto typeKeys=body.keys();
+    if(!body.value("type").isString() || !body.value("generation").isString() || (body.value("type")=="offer" && !body.value("sdp").isString()) || typeKeys.size()!=(body.value("type")=="offer" ? 3 : 2) || !body.contains("type") || !body.contains("generation") || (body.value("type")=="offer" && !body.contains("sdp"))){Fail();return;}
+    if(!main || url!=pageUrl || QJsonDocument(body).toJson(QJsonDocument::Compact).size()>65536){Fail();return;}
+    const auto type=body.value("type").toString();
+    if(type=="loaded" && body.value("generation").toString().isEmpty() && !offeredOnce){Command("prepare");return;}
+    if(type=="error" && body.value("generation").toString().isEmpty() && !offeredOnce){Fail();return;}
+    if(body.value("generation")!=generation)return; // Retired generation never acts.
+    if(type=="offer" && !offeredOnce && ValidSdp(body.value("sdp").toString())) {
+        offeredOnce=true;deadline.start(20000);if(offered)offered(generation,body.value("sdp").toString());
+    } else if(type=="negotiated" && answered && !ready) {
+        ready=true;deadline.start(20000);if(negotiated)negotiated(generation);
+    } else if(type=="capturing" && muted) {
+        return; // A late capture acknowledgment cannot undo native mute.
+    } else if(type=="capturing" && captureRequested && !capturing) {
+        capturing=true;deadline.stop();if(changed)changed();
+    } else Fail();
+}
+void DirectorMediaPeer::Answer(const QString &serial,const QString &sdp)
+{
+    if(serial!=generation || !Active())return;
+    if(!offeredOnce || answered || !ValidSdp(sdp)){Fail();return;}
+    answered=true;Command("answer",sdp);
+}
+void DirectorMediaPeer::Capture(const QString &serial)
+{
+    if(serial!=generation || !Active())return;
+    if(!ready || captureRequested){Fail();return;}captureRequested=true;Command("capture");
+}
+void DirectorMediaPeer::Mute(bool value){
+    if(!ready || value==muted)return;
+    muted=value;capturing=false;captureRequested=!value;
+    if(value)deadline.stop();else deadline.start(20000);
+    Command(value ? "mute" : "unmute");if(changed)changed();
+}
+void DirectorMediaPeer::Stop()
+{
+    const auto retired=generation;generation.clear();deadline.stop();server.close();
+    if(!retired.isEmpty() && effects.command)effects.command({{"type","stop"},{"generation",retired}});
+    for(auto socket:server.findChildren<QTcpSocket *>())socket->abort();
+    if(effects.stop)effects.stop();pageUrl=QUrl{};offeredOnce=answered=ready=captureRequested=capturing=muted=false;
+    if(changed)changed();
+}
+void DirectorMediaPeer::Fail(){Stop();if(failed)failed();}
+#ifndef __APPLE__
+DirectorMediaPeer::Effects DirectorPlatformMediaEffects(){return {};}
+#endif
