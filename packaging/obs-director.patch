diff --git a/frontend/tests/DirectorShellTest.cpp b/frontend/tests/DirectorShellTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..80528283ac4742859e0c7f4ba6538f3d44392d30
--- /dev/null
+++ b/frontend/tests/DirectorShellTest.cpp
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Widgets-only behavioral checks: no libobs, devices, services or output objects.
+#include "DirectorShell.hpp"
+#include "DirectorPanel.hpp"
+#include "DirectorBrowserPolicy.hpp"
+#include <QTabWidget>
+#include <QScrollArea>
+#include <QScrollBar>
+#include <QAction>
+#include <QApplication>
+#include <QCoreApplication>
+#include <QEvent>
+#include <QLineEdit>
+#include <QMainWindow>
+#include <QMenuBar>
+#include <QPushButton>
+#include <QSlider>
+#include <QLabel>
+#include <QVBoxLayout>
+#include <iostream>
+
+namespace {
+int failures = 0;
+void check(bool condition, const char *description)
+{
+	if (!condition) {
+		std::cerr << "FAIL: " << description << '\n';
+		++failures;
+	}
+}
+
+void processEvents()
+{
+	QCoreApplication::sendPostedEvents();
+	QCoreApplication::processEvents();
+}
+
+class ShowProbe : public QObject {
+public:
+	int shows = 0;
+	bool eventFilter(QObject *, QEvent *event) override
+	{
+		if (event->type() == QEvent::Show || event->type() == QEvent::ShowToParent)
+			++shows;
+		return false;
+	}
+};
+
+QDockWidget *addLegacyDock(QMainWindow &window)
+{
+	auto dock = new QDockWidget("Scenes", &window);
+	dock->setObjectName("scenesDock");
+	window.addDockWidget(Qt::LeftDockWidgetArea, dock);
+	return dock;
+}
+
+void savedLayoutResetAndReturn()
+{
+	QByteArray normalSaved;
+	{
+		QMainWindow window;
+		window.resize(1000, 700);
+		auto central = new QWidget(&window);
+		auto workspace = new QVBoxLayout(central);
+		auto preview = new QLabel("Native preview placeholder",central);
+		auto program = new QLabel("Native program placeholder",central);
+		auto transitions = new QWidget(central);
+		transitions->setObjectName("directorLegacyTransitions");
+		workspace->addWidget(preview); workspace->addWidget(program); workspace->addWidget(transitions);
+		window.setCentralWidget(central);
+		auto legacy = addLegacyDock(window);
+		auto profile = window.menuBar()->addAction("Profiles");
+		ShowProbe probe;
+		legacy->installEventFilter(&probe);
+		window.show();
+		processEvents();
+		check(window.isVisible() && legacy->isVisible(), "offscreen legacy workspace is shown");
+		check(probe.shows > 0, "real dock show events were delivered");
+		const auto oldLayout = window.saveState();
+		int studioRequests = 0;
+		auto shell = new DirectorShell(&window, [&] { ++studioRequests; });
+		processEvents();
+		check(!shell->IsAdvanced() && shell->isVisible(), "normal mode shows Director panel");
+		check(legacy->isHidden() && !legacy->isVisible(), "normal mode hides legacy dock");
+		check(!profile->isVisible(), "normal mode hides profile action");
+		check(transitions->isHidden() && preview->isVisible() && program->isVisible(), "normal hides central transitions while preserving preview/program");
+		transitions->show(); processEvents();
+		check(transitions->isHidden(), "late central transition show cannot leak into Director mode");
+		check(window.restoreState(oldLayout), "old dock layout can be restored");
+		processEvents();
+		check(legacy->isHidden(), "saved legacy layout cannot resurrect normal-mode clutter");
+		legacy->show();
+		processEvents();
+		check(legacy->isHidden(), "late dock show is suppressed");
+
+		QPushButton *advancedButton = nullptr;
+		for (auto button : shell->findChildren<QPushButton *>())
+			if (button->isEnabled())
+				advancedButton = button;
+		check(advancedButton != nullptr, "Advanced navigation is available");
+		if (advancedButton)
+			advancedButton->click();
+		processEvents();
+		check(shell->IsAdvanced() && legacy->isVisible(), "panel navigation restores Advanced docks");
+		check(profile->isVisible(), "Advanced restores profile action");
+		check(transitions->isVisible(), "Advanced restores deliberate manual transition controls");
+		if (advancedButton)
+			advancedButton->click();
+		processEvents();
+		check(!shell->IsAdvanced() && shell->isVisible() && legacy->isHidden(), "panel navigation returns to Director");
+		check(studioRequests >= 2, "startup and return request Studio workspace");
+		check(transitions->isHidden() && preview->isVisible() && program->isVisible(), "return keeps native canvases and hides transition UI");
+		normalSaved = window.saveState();
+	}
+	// Fresh window, fresh shell: simulate relaunch without retaining QObject/menu state.
+	{
+		QMainWindow window;
+		window.resize(1000, 700);
+		auto legacy = addLegacyDock(window);
+		check(window.restoreState(normalSaved), "normal-mode layout survives fresh-window restore");
+		auto shell = new DirectorShell(&window, [] {});
+		window.show();
+		processEvents();
+		check(shell->isVisible() && legacy->isHidden(), "relaunch keeps Director usable");
+		shell->SetAdvanced(true);
+		processEvents();
+		check(legacy->isVisible(), "Advanced recovers setup from normal-mode saved layout");
+		shell->SetAdvanced(false);
+		processEvents();
+		check(shell->isVisible() && legacy->isHidden(), "relaunch can return to Director mode");
+	}
+}
+
+void disconnectedControlsCannotAct()
+{
+	QMainWindow window;
+	auto shell = new DirectorShell(&window, [] {});
+	window.show();
+	processEvents();
+	const auto inputs = shell->findChildren<QLineEdit *>();
+	check(!inputs.isEmpty(), "conversation input exists");
+	for (auto input : inputs)
+		if (input->objectName() == "directorConversation")
+			check(!input->isEnabled(), "disconnected conversation input is disabled");
+	int disabled = 0;
+	int enabled = 0;
+	for (auto button : shell->findChildren<QPushButton *>()) {
+		if (button->isEnabled())
+			++enabled;
+		else
+			++disabled;
+	}
+	check(disabled >= 7 && enabled >= 1, "planned show controls disabled; explicit connection/navigation available");
+	const auto levels = shell->findChildren<QSlider *>();
+	check(!levels.isEmpty(), "planned audio level control exists");
+	for (auto level : levels)
+		check(!level->isEnabled(), "unconnected audio level control is disabled");
+}
+
+void browserLoadPolicy()
+{
+    for (bool built : {false,true}) {
+        for (const QStringList &arguments : {QStringList{},QStringList{"--director-browser-sources"},
+             QStringList{"--director-browser-sources=true"},QStringList{"--other"}}) {
+            QStringList disabled;
+            DirectorBrowserPolicy::BeforeModuleLoad(built,arguments,[&](const char *name) { disabled.append(name); });
+            const bool expected = built && arguments == QStringList{"--director-browser-sources"};
+            check(DirectorBrowserPolicy::Enabled(built,arguments) == expected,"build and exact runtime opt-in independently required");
+            check(disabled == (expected ? QStringList{} : QStringList{"obs-browser"}),"browser excluded before module initialization irrespective of saved enablement");
+        }
+    }
+    check(!DirectorBrowserPolicy::Status({}).isEmpty(),"browser unavailability is visible to operator");
+    std::cout << "Browser compiled: " << DirectorBrowserPolicy::Built() << " runtime default disabled\n";
+}
+
+void boundedPanelGeometry()
+{
+    DirectorPanel panel;
+    panel.resize(480, 700); panel.show(); processEvents();
+    std::cout << "Panel normal minimum " << panel.minimumSizeHint().width() << "x"
+              << panel.minimumSizeHint().height() << " hint " << panel.sizeHint().width()
+              << "x" << panel.sizeHint().height() << " actual " << panel.width() << "x" << panel.height() << '\n';
+    check(panel.width() <= 480 && panel.height() <= 700, "panel fits a 480x700 dock without forcing window growth");
+    auto tabs = panel.findChild<QTabWidget *>("directorSections");
+    check(tabs && tabs->count() == 2, "single panel has native Direct and Audience sections");
+    if (!tabs) return;
+    for (int index=0; index<tabs->count(); ++index) {
+        tabs->setCurrentIndex(index); processEvents();
+        auto scroll = qobject_cast<QScrollArea *>(tabs->widget(index));
+        check(scroll != nullptr, "section has bounded native scrolling");
+        if (!scroll) continue;
+        for (auto button : scroll->widget()->findChildren<QPushButton *>()) {
+            if (!button->isVisibleTo(scroll->widget())) continue;
+            scroll->ensureWidgetVisible(button); processEvents();
+            const QRect rect(button->mapTo(scroll->viewport(),QPoint()),button->size());
+            check(scroll->viewport()->rect().contains(rect), "section action is fully reachable without growing window");
+        }
+        check(scroll->horizontalScrollBar()->maximum() == 0, "normal dock has no horizontal scroll requirement");
+    }
+    panel.SetAdvanced(true); processEvents();
+    check(panel.findChild<QPushButton *>("operatorUseOwnObs") != nullptr, "native Advanced exposes explicit own-app OBS connection");
+    check(panel.findChild<QPushButton *>("operatorArm") != nullptr, "native Advanced exposes deliberate owned OBS arming");
+    check(panel.width() <= 480 && panel.height() <= 700, "Advanced setup does not force window growth");
+    tabs->setCurrentIndex(0); processEvents();
+    auto direct=qobject_cast<QScrollArea *>(tabs->widget(0));
+    auto setupTabs=panel.findChild<QTabWidget *>("operatorSetupSections");
+    for(int index=0;setupTabs && index<setupTabs->count();++index) {
+        setupTabs->setCurrentIndex(index);processEvents();
+        for(auto button:direct->widget()->findChildren<QPushButton *>()) {
+            if(!button->isVisibleTo(direct->widget()))continue;
+            direct->ensureWidgetVisible(button);processEvents();
+            check(direct->viewport()->rect().contains(QRect(button->mapTo(direct->viewport(),QPoint()),button->size())),"Advanced operator action reachable at normal dock size");
+        }
+        check(direct->horizontalScrollBar()->maximum()==0,"Advanced setup has no horizontal scroll requirement");
+    }
+    auto cancelPreparation=panel.findChild<QPushButton *>("directorCancelPreparation");
+    check(cancelPreparation && panel.rect().contains(QRect(cancelPreparation->mapTo(&panel,QPoint()),cancelPreparation->size())),"cancel preparation stays outside scrollers and reachable");
+
+}
+
+void refusalPolicyOnly()
+{
+	// This calls only the shared policy function. It does NOT prove native
+	// frontend/RPC dispatch or output entry-point integration; those need OBS tests.
+	QMainWindow window;
+	auto shell = new DirectorShell(&window, [] {});
+	window.show();
+	for (bool advanced : {false, true, false}) {
+		shell->SetAdvanced(advanced);
+		processEvents();
+		for (const char *name : {"Streaming", "Recording", "ReplayBuffer", "VirtualCam", "AutoConfigurationBenchmark"})
+			check(DirectorShell::RefuseOutputStart(name), "demo refusal policy remains active in either view");
+	}
+}
+} // namespace
+
+// check/processEvents are shared with the independent fake integration checks.
+#include "DirectorSessionChecks.hpp"
+#include "DirectorParticipationChecks.hpp"
+#include "DirectorOperatorSetupChecks.hpp"
+#include "DirectorManagedVoiceChecks.hpp"
+#include "DirectorVoiceChecks.hpp"
+
+int main(int argc, char **argv)
+{
+	if (argc > 1 && QString::fromLocal8Bit(argv[1]) == "app-server") return fakeAppServer();
+	if (argc > 1 && QString::fromLocal8Bit(argv[1]).endsWith("director_twitch_native.py")) return fakeTwitchHost(argc,argv);
+	// Force the test platform before QApplication; never launch a native OBS UI.
+	qputenv("QT_QPA_PLATFORM", "offscreen");
+	QApplication app(argc, argv);
+	app.setQuitOnLastWindowClosed(false);
+	savedLayoutResetAndReturn();
+	disconnectedControlsCannotAct();
+	refusalPolicyOnly();
+	boundedPanelGeometry();
+	browserLoadPolicy();
+	directorSessionChecks();
+	directorParticipationChecks();
+    directorOperatorSetupChecks();
+    directorVoiceChecks();
+	if (failures) {
+		std::cerr << failures << " shell checks failed\n";
+		return 1;
+	}
+	std::cout << "PASS: offscreen Qt Widgets shell checks (policy check is not frontend dispatch proof)\n";
+	return 0;
+}
diff --git a/frontend/tests/DirectorVoiceChecks.hpp b/frontend/tests/DirectorVoiceChecks.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1a4bbe4c4f2b65f6e4776371499f260eb92a59f
--- /dev/null
+++ b/frontend/tests/DirectorVoiceChecks.hpp
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "DirectorVoiceAudio.hpp"
+
+inline void directorVoiceChecks()
+{
+    // Inject ALL audio effects. No Qt permission/device methods are called here.
+    int opens=0,stops=0,permissions=0,plays=0,mutes=0,errors=0;
+    std::function<void(bool)> permission;
+    std::function<void(QByteArray)> capture;
+    DirectorVoiceAudio audio;
+    check(audio.SetEffects({[&](auto done){++permissions;permission=done;},
+        [&](auto bytes,auto){++opens;capture=bytes;return true;},
+        [&](const QByteArray &bytes){++plays;return bytes.size()==4800;},[&]{++stops;},[&](bool){++mutes;}}),"inject device effects before any start");
+    audio.failed=[&]{++errors;};
+    QList<QJsonObject> frames;
+    audio.input=[&](const auto &frame){frames.append(frame);return true;};
+    check(!audio.Active() && opens==0 && permissions==0,"construction never probes devices or permissions");
+    audio.Start();check(permissions==1 && opens==0,"permission readiness precedes open");
+    audio.Stop();permission(true);check(opens==0,"late permission grant after Stop cannot capture");
+    audio.Start();permission(false);check(errors==1 && opens==0,"denied permission stops without device open");
+    audio.Start();permission(true);check(audio.Listening() && opens==1,"explicit permitted start opens injected capture");
+    capture(QByteArray(4799,'x'));check(frames.isEmpty(),"partial PCM waits for complete bounded frame");
+    capture(QByteArray(1,'x'));check(frames.size()==1 && frames[0].value("samplesPerChannel")==2400,"100ms exact PCM16 framing");
+    audio.Mute(true);capture(QByteArray(4800,'x'));check(frames.size()==1 && !audio.Listening() && mutes==1,"mute suspends capture and discards late callbacks");
+    audio.Mute(false);capture(QByteArray(4800,'x'));check(frames.size()==2,"explicit unmute resumes bounded stream");
+    QJsonObject output{{"data",QString::fromLatin1(QByteArray(4800,0).toBase64())},{"sampleRate",24000},{"numChannels",1},{"samplesPerChannel",2400}};
+    audio.Output(output);check(plays==1,"validated output reaches injected speaker only");
+    output.insert("sampleRate",48000);audio.Output(output);check(!audio.Active() && errors==2 && plays==1,"unsupported output format fails closed without invented resampling");
+    capture(QByteArray(4800,'x'));check(frames.size()==2,"retired capture generation cannot send audio");
+    audio.Start();permission(true);capture(QByteArray(9601,'x'));check(!audio.Active() && errors==3,"oversized capture bounded before transport");
+    audio.Start();permission(true);audio.input=[](const auto &){return false;};capture(QByteArray(4800,'x'));check(!audio.Active() && errors==4,"backpressure immediately stops device");
+
+    directorManagedVoiceChecks();
+}
