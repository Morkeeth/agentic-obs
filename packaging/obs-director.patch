+QString DirectorSession::PermissionNotice()
+{
+    return QStringLiteral("Trusted local Codex client: platform read-only sandbox, never escalate. Optional shell/browser/computer/apps/plugins disabled where supported; unified execution may remain available under platform policy. Director MCP is bounded, not whole-client filesystem/tool isolation. ChatGPT subscription only; no paid API fallback.");
+}
+DirectorSession::DirectorSession(QObject *parent) : QObject(parent)
+{
+    voiceDeadline.setSingleShot(true);
+    QObject::connect(&voiceDeadline,&QTimer::timeout,this,[this]{Fail(QStringLiteral("Realtime readiness/audio deadline expired; microphone stopped"));});
+    openSignIn = [](const QUrl &url) { return QDesktopServices::openUrl(url); };
+    process.setProcessChannelMode(QProcess::SeparateChannels);
+    deadline.setSingleShot(true);
+    QObject::connect(&deadline,&QTimer::timeout,this,[this] { Fail(QStringLiteral("App Server deadline expired; stopped without action retry")); });
+    QObject::connect(&process,&QProcess::started,this,[this] {
+        Send("initialize",{{"clientInfo",QJsonObject{{"name","codex_director_native"},{"title","Codex Director"},{"version","0.2"}}},
+            {"capabilities",QJsonObject{{"experimentalApi",true},{"explicitGatewayOauth",true}}}});
+    });
+    QObject::connect(&process,&QProcess::readyReadStandardOutput,this,[this] { Read(); });
+    QObject::connect(&process,&QProcess::readyReadStandardError,this,[this] { process.readAllStandardError(); });
+    QObject::connect(&process,&QProcess::errorOccurred,this,[this](QProcess::ProcessError error) {
+        if (error != QProcess::Crashed) Fail(QStringLiteral("App Server process unavailable; no fallback"));
+    });
+    QObject::connect(&process,qOverload<int,QProcess::ExitStatus>(&QProcess::finished),this,[this](int,QProcess::ExitStatus) {
+        ResetVoice();
+        const bool unexpected = initialized || working || !pending.isEmpty();
+        initialized = subscribed = working = cancelling = false;
+        pending.clear(); queuedText.clear(); loginId.clear(); threadId.clear(); turnId.clear(); buffer.clear(); deadline.stop();
+        if (unexpected) status = QStringLiteral("App Server lost; show outcome must be read from controller. Reconnect explicitly; no replay.");
+        Notify();
+    });
+}
+DirectorSession::~DirectorSession() { voiceReady={}; ResetVoice(); process.disconnect(this); process.kill(); process.waitForFinished(1000); }
+void DirectorSession::Notify() { if (changed) changed(); }
+void DirectorSession::Append(const QString &text) { transcript += text; if (transcript.size()>65536) transcript = transcript.right(65536); }
+void DirectorSession::Fail(const QString &message)
+{
+    ResetVoice();
+    initialized = subscribed = working = cancelling = false;
+    pending.clear(); queuedText.clear(); loginId.clear(); threadId.clear(); turnId.clear(); buffer.clear(); deadline.stop();
+    status = message; process.kill(); Notify();
+}
+void DirectorSession::Disconnect() { Fail(QStringLiteral("App Server disconnected; no show actions replayed")); }
+void DirectorSession::Cancel()
+{
+    if (VoiceBusy()) { StopVoice(); return; }
+    queuedText.clear();
+    if (!loginId.isEmpty() && pending.isEmpty()) {
+        Send("account/login/cancel",{{"loginId",loginId}}); loginId.clear();
+        status = QStringLiteral("Cancelling sign-in"); deadline.start(3000); Notify();
+    } else if (working && !turnId.isEmpty() && !cancelling) {
+        cancelling = true;
+        Send("turn/interrupt",{{"threadId",threadId},{"turnId",turnId}});
+        status = QStringLiteral("Interrupt requested; waiting for completion. Disconnect is always available.");
+        deadline.start(3000); Notify();
+    } else Fail(QStringLiteral("Cancelled owned App Server; committed show actions are not rolled back"));
+}
+void DirectorSession::Connect(const QString &executable,const QString &project,int port,const QString &configRoot)
+{
+    if (Busy()) return;
+    if (!QFileInfo(executable).isAbsolute() || !QFileInfo(executable).isExecutable() ||
+        !QFileInfo(project).isAbsolute() || !QFileInfo(project+"/director_mcp.py").isFile() ||
+        !QFileInfo(project+"/.venv/bin/python").isExecutable() || !QFileInfo(configRoot).isAbsolute() ||
+        port<1024 || port>65535 || port==4455 || port==8877 || port==8878 || port==8879) {
+        Fail(QStringLiteral("Select installed Codex and director project; application config and loopback port required")); return;
+    }
+    const auto projectPath = QFileInfo(project).canonicalFilePath();
+    const auto projectKey = QString::fromLatin1(QCryptographicHash::hash(projectPath.toUtf8(),QCryptographicHash::Sha256).toHex());
+    const QString root = configRoot+"/"+projectKey;
+    const QString home = root+"/codex-home";
+    work = root+"/work/"+QUuid::createUuid().toString(QUuid::WithoutBraces);
+    if (!QDir().mkpath(home) || !QDir().mkpath(work) || !QDir().mkpath(root+"/tmp") || !QDir().mkpath(root+"/process-home")) {
+        Fail(QStringLiteral("Cannot create dedicated application runtime")); return;
+    }
+    // Compare/send the real owned workspace path, including macOS /var aliases.
+    work = QFileInfo(work).canonicalFilePath();
+    QFile marker(work+"/.director-workspace");
+    if (!marker.open(QIODevice::WriteOnly)) { Fail(QStringLiteral("Cannot create fresh runtime workspace")); return; }
+    marker.close();
+    QFile config(home+"/config.toml");
+    if (!config.open(QIODevice::WriteOnly|QIODevice::Truncate)) { Fail(QStringLiteral("Cannot create dedicated runtime config")); return; }
+    auto quote=[](const QString &value) { return QString::fromUtf8(QJsonDocument(QJsonArray{value}).toJson(QJsonDocument::Compact)).mid(1).chopped(1); };
+    const QString text=QStringLiteral(
+        "forced_login_method = \"chatgpt\"\ncli_auth_credentials_store = \"keyring\"\nmodel_provider = \"openai\"\n"
+        "approval_policy = \"never\"\nsandbox_mode = \"read-only\"\nweb_search = \"disabled\"\nproject_doc_max_bytes = 0\n"
+        "project_root_markers = [\".director-workspace\"]\n"
+        "[features]\nshell_tool = false\napps = false\nmulti_agent = false\nhooks = false\nremote_plugin = false\nplugins = false\nmemories = false\nshell_snapshot = false\nbrowser_use = false\nbrowser_use_external = false\ncomputer_use = false\nin_app_browser = false\ncode_mode_host = false\n"
+        "[mcp_servers.expanded_director]\ncommand = %1\nargs = [%2, \"--port\", \"%3\"]\nrequired = true\n").arg(quote(projectPath+"/.venv/bin/python"),quote(projectPath+"/director_mcp.py")).arg(port);
+    if (config.write(text.toUtf8())!=text.toUtf8().size()) { Fail(QStringLiteral("Cannot write runtime configuration")); return; }
+    config.close();
+    QProcessEnvironment env;
+    env.insert("PATH","/usr/bin:/bin:/usr/sbin:/sbin"); env.insert("HOME",root+"/process-home");
+    env.insert("CODEX_HOME",home); env.insert("TMPDIR",root+"/tmp");
+    process.setProcessEnvironment(env); process.setWorkingDirectory(work);
+    buffer.clear(); pending.clear(); initialized=subscribed=working=cancelling=refreshAuth=false;
+    queuedText.clear(); loginId.clear(); threadId.clear(); turnId.clear(); lastFinished.clear(); transcript.clear();
+    status=QStringLiteral("Starting dedicated stdio App Server; no sign-in or turn automatically"); Notify();
+    process.start(executable,{"app-server","--listen","stdio://"}); deadline.start(10000);
+}
+void DirectorSession::SignIn()
+{
+    if (!CanSignIn()) return;
+    Send("account/login/start",{{"type","chatgpt"}});
+    status=QStringLiteral("Managed ChatGPT sign-in requested by operator"); Notify();
+}
+bool DirectorSession::Submit(const QString &text)
+{
+    if (!CanSubmit() || text.trimmed().isEmpty() || text.toUtf8().size()>16000) return false;
+    queuedText=text; working=true; cancelling=false;
+    // Recheck subscription auth on every operator submission; never trust a cached mode.
+    ReadAccount(); status=QStringLiteral("Checking subscription before submitted turn"); Notify(); return true;
+}
+void DirectorSession::ReadAccount() { Send("account/read",{{"refreshToken",false}}); }
+void DirectorSession::Send(const QString &method,const QJsonObject &params)
+{
+    const int id=++request; pending.insert(id,method);
+    const auto bytes=QJsonDocument(QJsonObject{{"id",id},{"method",method},{"params",params}}).toJson(QJsonDocument::Compact)+'\n';
+    if (bytes.size()>131072 || process.bytesToWrite()>65536 || process.write(bytes)!=bytes.size()) { Fail(QStringLiteral("App Server write failed")); return; }
+    deadline.start(cancelling ? 3000 : 10000);
+}
+void DirectorSession::StartThreadOrTurn()
+{
+    if (!threadId.isEmpty()) { StartTurn(); return; }
+    const QString instructions=QStringLiteral("You are the streamer's trusted live director. Use only expanded_director MCP for show work. First read director_status. Give a brief plain-language plan; author full arbitrary schema-valid compositions, then preview. Never take without the controller's exact human approval. Never approve, connect, set up, arm or control outputs. No shell, web, computer, filesystem exploration, other threads or viewer requests. Only explicitly selected material may be read through its bounded tool. Text replies are not show truth; report actual tool results and pending review honestly. Voice speech is not pixel proof. Keep spoken feedback brief: plan, actual tool results, pending human review. Never grant approval yourself. Canonical user speech is uplink input, not person identity. Only a local human inspected-preview click can arm one short-lived exact spoken Take via the native operator route; speech cannot arm itself.");
+    Send("thread/start",{{"cwd",work},{"modelProvider","openai"},{"allowProviderModelFallback",false},
+        {"approvalPolicy","never"},{"sandbox","read-only"},{"ephemeral",true},{"developerInstructions",instructions}});
+    status=QStringLiteral("Creating a new dedicated runtime show thread"); Notify();
+}
+void DirectorSession::StartTurn()
+{
+    const QString text=queuedText; queuedText.clear();
+    if (text.isEmpty() || !subscribed || threadId.isEmpty()) { Fail(QStringLiteral("Turn lacks a current authenticated operator submission")); return; }
+    turnId.clear(); streamedItems.clear();
+    Append("\nOperator: "+text+"\nCodex: ");
+    Send("turn/start",{{"threadId",threadId},{"approvalPolicy","never"},
+        {"sandboxPolicy",QJsonObject{{"type","readOnly"},{"networkAccess",false}}},
+        {"input",QJsonArray{QJsonObject{{"type","text"},{"text",text}}}}});
+    status=QStringLiteral("Submitted operator turn; controller tools remain approval-gated"); Notify();
+}
+void DirectorSession::Read()
+{
+    buffer+=process.readAllStandardOutput();
+    if (buffer.size()>131072) { Fail(QStringLiteral("App Server message exceeds limit")); return; }
+    while (buffer.contains('\n')) {
+        const auto line=buffer.left(buffer.indexOf('\n')); buffer.remove(0,line.size()+1);
+        QJsonParseError error; const auto doc=QJsonDocument::fromJson(line,&error);
+        if (error.error!=QJsonParseError::NoError || !doc.isObject()) { Fail(QStringLiteral("Invalid App Server JSON")); return; }
+        Handle(doc.object()); if (!Busy() || (!initialized && pending.isEmpty())) return;
+    }
+}
+void DirectorSession::Handle(const QJsonObject &message)
+{
+    if (message.contains("method")) {
+        if (message.contains("id")) { Fail(QStringLiteral("App Server requested unsupported approval/tool execution; refused without escalation")); return; }
+        Notification(message.value("method").toString(),message.value("params").toObject()); return;
+    }
+    const int id=message.value("id").toInt(-1);
+    if (!pending.contains(id)) { Fail(QStringLiteral("App Server response identity mismatch")); return; }
+    const QString method=pending.take(id);
+    if(message.contains("error") && method=="thread/realtime/start") {
+        ResetVoice();working=false;threadId.clear();turnId.clear();
+        if(pending.isEmpty())deadline.stop();
+        status=QStringLiteral("Managed WebRTC start refused; no paid/provider fallback. Ordinary text directing remains available.");
+        voiceStatus=status;Notify();return;
+    }
+    if (message.contains("error") || !message.value("result").isObject()) { Fail(QStringLiteral("App Server refused request; no model/provider fallback or mutation retry")); return; }
+    const auto result=message.value("result").toObject();
+    if (pending.isEmpty()) deadline.stop();
+    if (method=="initialize") {
+        process.write("{\"method\":\"initialized\",\"params\":{}}\n"); initialized=true; ReadAccount();
+    } else if (method=="account/read") {
+        const auto type=result.value("account").toObject().value("type").toString(); subscribed=(type=="chatgpt");
+        if (!type.isEmpty() && !subscribed) { Fail(QStringLiteral("Non-subscription authentication refused; API-key/provider mode cannot run turns")); return; }
+        if (!subscribed) { if(VoiceBusy())ResetVoice(); working=false; queuedText.clear(); threadId.clear(); status=QStringLiteral("Not signed in. Use explicit managed ChatGPT sign-in; keyring required, no API fallback."); }
+        else if (voiceRequested && threadId.isEmpty()) {
+            const auto account=result.value("account").toObject();
+            if(result.value("workspaceRouting").toObject().value("chatgptAccountId").toString().isEmpty() && account.value("email").toString().isEmpty()) {
+                Fail(QStringLiteral("Managed voice requires authenticated account identity; microphone stayed off"));return;
+            }
+            StartThreadOrTurn();
+        }
+        else if (working && !queuedText.isEmpty()) StartThreadOrTurn();
+        else if (working) { if (!cancelling) status=QStringLiteral("Subscription rechecked; current turn remains in progress"); }
+        else status=QStringLiteral("ChatGPT subscription authenticated; ready for operator authoring");
+    } else if (method=="account/login/start") {
+        const QUrl url(result.value("authUrl").toString()); loginId=result.value("loginId").toString();
+        if (result.value("type")!="chatgpt" || loginId.isEmpty() || url.scheme()!="https" ||
+            (url.host()!="auth.openai.com" && url.host()!="chatgpt.com") || !url.userInfo().isEmpty()) {
+            Fail(QStringLiteral("Managed sign-in response invalid; no URL opened")); return;
+        }
+        if (!openSignIn || !openSignIn(url)) { Fail(QStringLiteral("Cannot open operator-requested managed sign-in; no credential fallback")); return; }
+        status=QStringLiteral("Complete managed sign-in in your browser; Cancel remains available"); deadline.start(180000);
+    } else if (method=="account/login/cancel") {
+        loginId.clear(); status=QStringLiteral("Sign-in cancelled"); ReadAccount();
+    } else if (method=="thread/start") {
+        const auto sandbox=result.value("sandbox").toObject();
+        if (result.value("approvalPolicy")!="never" || sandbox.value("type")!="readOnly" || sandbox.value("networkAccess").toBool() ||
+            result.value("modelProvider")!="openai" || result.value("cwd")!=work ||
+            !result.value("instructionSources").toArray().isEmpty()) {
+            Fail(QStringLiteral("Runtime thread permission/context differs from requested policy; stopped without weakening platform refusal")); return;
+        }
+        threadId=result.value("thread").toObject().value("id").toString();
+        if (threadId.isEmpty()) { Fail(QStringLiteral("Missing dedicated thread identity")); return; }
+        if(voiceRequested) BeginRealtime(); else StartTurn();
+    } else if (method=="thread/realtime/start") {
+        voiceStartAccepted=true;MaybeVoiceReady();
+    } else if (method=="turn/start") {
+        const auto id=result.value("turn").toObject().value("id").toString();
+        if (id.isEmpty() || (!turnId.isEmpty() && turnId!=id)) { Fail(QStringLiteral("Turn identity mismatch")); return; }
+        if (lastFinished!=id) { turnId=id; working=true; deadline.start(cancelling ? 3000 : 120000); }
+    } else if (method=="turn/interrupt") {
+        if (working) deadline.start(3000);
+    }
+    if (refreshAuth && pending.isEmpty()) { refreshAuth=false; ReadAccount(); }
+    if (working && pending.isEmpty()) deadline.start(cancelling ? 3000 : 120000);
+    Notify();
+}
+void DirectorSession::Notification(const QString &method,const QJsonObject &params)
+{
+    if(method.startsWith("thread/realtime/")) {
+        if(threadId.isEmpty() || params.value("threadId")!=threadId || !VoiceBusy())return;
+        if(method=="thread/realtime/started") {
+            if(!voiceRequested || !voiceOfferSent || params.value("realtimeSessionId")!=voiceSessionId || params.value("version")!="v3" || voiceActive) {
+                Fail(QStringLiteral("Realtime session identity/version mismatch; microphone stayed off"));return;
+            }
+            voiceActive=true;MaybeVoiceReady();
+        } else if(method=="thread/realtime/sdp") {
+            const auto sdp=params.value("sdp").toString();
+            if(!voiceOfferSent || !voiceSdp.isEmpty() || !DirectorMediaPeer::ValidSdp(sdp)) {Fail(QStringLiteral("Managed SDP refused; no diagnostic payload retained"));return;}
+            voiceSdp=sdp;if(answerVoice)answerVoice(voiceSessionId,voiceSdp);else {Fail(QStringLiteral("Native media peer unavailable"));return;}
+        } else if(method=="thread/realtime/item/completed" && voiceCaptureGranted) {
+            const auto item=params.value("item").toObject();
+            const auto id=item.value("id").toString();
+            if(item.value("realtimeSessionId")!=voiceSessionId || item.value("type")!="transcriptSegment" || item.value("role")!="user" || id.isEmpty() || id.size()>256 || !item.value("text").isString() || item.value("text").toString().size()>16000 || voiceItems.contains(id))return;
+            voiceItems.insert(id);voiceItemOrder.enqueue(id);
+            if(voiceItemOrder.size()>128)voiceItems.remove(voiceItemOrder.dequeue());
+            if(voiceUserFinal)voiceUserFinal(voiceSessionId,id,item.value("text").toString());
+        } else if(method=="thread/realtime/error" || method=="thread/realtime/closed") {
+            Fail(QStringLiteral("Managed realtime unavailable or closed; microphone stopped. No API-key/provider fallback. Reconnect explicitly for text."));return;
+        }
+        // No local transcript replay or arbitrary client data-channel commands.
+        Notify();return;
+    }
+    if (method=="account/updated") {
+        if(VoiceBusy()){Fail(QStringLiteral("Managed account changed during voice; capture stopped. Explicit reconnect required."));return;}
+        const auto mode=params.value("authMode").toString();
+        if (mode!="chatgpt") { subscribed=false; if (working || VoiceBusy()) { Fail(QStringLiteral("Subscription authentication changed during turn; stopped")); return; } }
+        if (pending.isEmpty()) ReadAccount(); else refreshAuth=true;
+        return;
+    }
+    if (method=="account/login/completed") {
+        if (loginId.isEmpty() || params.value("loginId")!=loginId) return;
+        loginId.clear();
+        if (!params.value("success").toBool()) { status=QStringLiteral("Managed sign-in failed or was cancelled; no fallback"); deadline.stop(); Notify(); return; }
+        if (pending.isEmpty()) ReadAccount(); else refreshAuth=true;
+        return;
+    }
+    if (threadId.isEmpty() || params.value("threadId")!=threadId) return;
+    const auto eventTurn=method=="turn/started" || method=="turn/completed" ? params.value("turn").toObject().value("id").toString() : params.value("turnId").toString();
+    if(voiceActive && method=="turn/started" && !eventTurn.isEmpty() && !working && eventTurn!=lastFinished) {
+        working=true;turnId=eventTurn;deadline.start(120000); // Same bounded policy as text turns; duplicate starts do not extend it.
+    }
+    if (eventTurn.isEmpty() || !working || (!turnId.isEmpty() && eventTurn!=turnId)) return;
+    if (turnId.isEmpty()) turnId=eventTurn;
+    if (method=="turn/completed") {
+        const auto state=params.value("turn").toObject().value("status").toString();
+        lastFinished=turnId; turnId.clear(); working=cancelling=false;
+        if (pending.isEmpty()) deadline.stop();
+        status=state=="completed" ? QStringLiteral("Turn completed; refresh controller and inspect native preview before any approval/take") :
+            state=="interrupted" ? QStringLiteral("Turn interrupted; committed tool effects require controller readback") : QStringLiteral("Turn failed; no automatic retry or fallback");
+        Append("\n");
+    } else if (method=="item/agentMessage/delta") {
+        const auto item=params.value("itemId").toString();
+        if (!item.isEmpty()) { streamedItems.insert(item); Append(params.value("delta").toString()); }
+    } else if (method=="item/completed") {
+        const auto item=params.value("item").toObject();
+        if (item.value("type")=="agentMessage" && !streamedItems.contains(item.value("id").toString())) Append(item.value("text").toString());
+    } else if (method=="error") {
+        Fail(QStringLiteral("Codex model/service error; inspect controller for actual show outcome. No paid fallback or automatic retry.")); return;
+    }
+    Notify();
+}
+
+DirectorController::DirectorController(QObject *parent) : QObject(parent)
+{
+	network.setProxy(QNetworkProxy::NoProxy);
+	freshness.setSingleShot(true); freshness.setInterval(2000);
+	QObject::connect(&freshness, &QTimer::timeout, this, [this] { Fail(QStringLiteral("Controller state expired; refresh and review again")); });
+}
+void DirectorController::Notify() { if (changed) changed(); }
+void DirectorController::Fail(const QString &message) { ready = false; observing = false; state = {}; status = message; freshness.stop(); Notify(); }
+void DirectorController::Disconnect() { ++generation; pending = false; base.clear(); Fail(QStringLiteral("Controller disconnected; no actions replayed")); }
+void DirectorController::Connect(int port)
+{
+	Disconnect();
+	if (port < 1024 || port > 65535 || port == 4455 || port == 8877 || port == 8878 || port == 8879) return;
+	base = QStringLiteral("http://127.0.0.1:%1").arg(port);
+	Request("/api/health");
+}
+void DirectorController::Refresh(bool background) {
+    if (!base.isEmpty() && !pending) { observing=background && ready; Request("/api/health"); }
+}
+void DirectorController::Request(const QString &path, const QJsonObject *body)
+{
+	if (pending || base.isEmpty()) return;
+	pending = true; if(!observing) { ready = false; freshness.stop(); } Notify();
+	QNetworkRequest req{QUrl(base + path)};
+	req.setTransferTimeout(12000);
+	req.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+	req.setRawHeader("Origin", base.toUtf8()); req.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+	const auto serial = generation;
+	auto reply = body ? network.post(req, QJsonDocument(*body).toJson(QJsonDocument::Compact)) : network.get(req);
+	reply->setReadBufferSize(131073);
+	QObject::connect(reply, &QNetworkReply::readyRead, reply, [reply] { if (reply->bytesAvailable() > 131072) reply->abort(); });
+	QObject::connect(reply, &QNetworkReply::finished, this, [this,reply,serial,path] {
+		const auto bytes = reply->readAll();
+		const auto error = reply->error(); const auto http = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		reply->deleteLater();
+		if (serial != generation) return;
+		pending = false;
+		const auto doc = QJsonDocument::fromJson(bytes); const auto result = doc.object();
+		if (error != QNetworkReply::NoError || http != 200 || bytes.size() > 131072 || !doc.isObject() || result.value("build") != "expanded-director-1") {
+			Fail(QStringLiteral("Controller unavailable/refused action; refresh, no automatic mutation retry")); return;
+		}
+		if (path == "/api/health") { Request("/api/agent-state"); return; }
+		if (!result.value("version").isDouble() || !result.value("stage_id").isDouble()) { Fail(QStringLiteral("Controller state schema mismatch")); return; }
+		state = result; ready = true; observing = false; status = QStringLiteral("Bounded controller connected; show truth comes from readback, not conversation");
+		freshness.start(); Notify();
+	});
+}
+void DirectorController::Action(const QString &action)
+{
+	if (!Ready() || (action != "preview" && action != "undo_camera_layout" && action != "restore")) return;
+	QJsonObject command{{"action",action}}; if (action == "preview") command.insert("target","obs");
+	const QJsonObject body{{"expected",state.value("version")},{"command",command}};
+	Request("/api/agent", &body);
+}
+void DirectorController::Review(const QJsonObject &identity, qint64 version, bool take)
+{
+	if (!Ready() || identity.isEmpty() || state.value("native_review").toObject() != identity || state.value("version").toInteger(-1) != version) {
+		Fail(QStringLiteral("Displayed native review changed; inspect refreshed preview")); return;
+	}
+	const QJsonObject body{{"expected",version},{"review",identity},{"operation",take ? "take" : "approve"}};
+	Request("/api/operator-review", &body);
+}
+
+void DirectorSession::ResetVoice()
+{
+    voiceRequested=voiceActive=voiceStartAccepted=voiceOfferSent=voiceNegotiated=voiceCaptureGranted=false;voiceDeadline.stop();voiceSessionId.clear();voiceSdp.clear();voiceItems.clear();voiceItemOrder.clear();
+    voiceStatus=QStringLiteral("Microphone off; exact native review remains manual");
+    if(voiceReady)voiceReady(false);
+}
+bool DirectorSession::StartVoice()
+{
+#ifndef Q_OS_MACOS
+    voiceStatus=QStringLiteral("Managed native voice requires macOS system WebKit; text directing remains available.");Notify();return false;
+#else
+    if(!CanSubmit())return false;
+    threadId.clear();turnId.clear();lastFinished.clear();
+    voiceRequested=true;voiceStartAccepted=false;working=true;
+    voiceSessionId=QUuid::createUuid().toString(QUuid::WithoutBraces);
+    voiceStatus=QStringLiteral("Checking managed subscription before realtime; microphone off");
+    ReadAccount();Notify();return true;
+#endif
+}
+void DirectorSession::BeginRealtime()
+{
+    working=false;voiceDeadline.start(20000);
+    voiceStatus=QStringLiteral("Preparing local WebRTC offer; microphone off");
+    if(prepareVoice)prepareVoice(voiceSessionId);else {Fail(QStringLiteral("Native WebRTC media peer unavailable on this platform"));return;}
+    Notify();
+}
+void DirectorSession::ProvideVoiceOffer(const QString &serial,const QString &sdp)
+{
+    if(serial!=voiceSessionId || !voiceRequested || threadId.isEmpty())return;
+    if(voiceOfferSent || !DirectorMediaPeer::ValidSdp(sdp)){Fail(QStringLiteral("Local SDP invalid; microphone stayed off"));return;}
+    voiceOfferSent=true;
+    Send("thread/realtime/start",{{"threadId",threadId},{"realtimeSessionId",voiceSessionId},
+        {"voiceSessionId",voiceSessionId},{"version","v3"},{"transport",QJsonObject{{"type","webrtc"},{"sdp",sdp}}},
+        {"outputModality","audio"},{"includeStartupContext",true},{"clientManagedHandoffs",false},
+        {"flushTranscriptTailOnSessionEnd",false},
+        {"realtimeStartInstructions","Use expanded_director only for show work. Read director_status; wait for genuine operator direction before authoring. For creative requests give a brief plan, author and preview, report actual results. For explicit spoken preview review/Take phrases do not author or mutate anything; acknowledge briefly. Human-manually-armed speech Take timing is handled only by the operator UI; never approve yourself or treat your own transcript/tool arguments as consent. Never arm, connect, set up or start outputs."}});
+    voiceStatus=QStringLiteral("Managed WebRTC negotiation pending; microphone off");Notify();
+}
+void DirectorSession::VoiceNegotiated(const QString &serial)
+{
+    if(serial!=voiceSessionId || !voiceRequested)return;
+    if(voiceSdp.isEmpty() || voiceNegotiated){Fail(QStringLiteral("Unexpected peer negotiation identity"));return;}
+    voiceNegotiated=true;MaybeVoiceReady();
+}
+void DirectorSession::MaybeVoiceReady()
+{
+    if(voiceCaptureGranted || !voiceStartAccepted || !voiceActive || !voiceNegotiated)return;
+    voiceCaptureGranted=true;voiceDeadline.stop();
+    voiceStatus=QStringLiteral("Managed WebRTC negotiated; explicit microphone permission/capture pending");
+    if(voiceReady)voiceReady(true);
+    Notify();
+}
+void DirectorSession::StopVoice()
+{
+    // End capture synchronously and terminate our owned process so late handoffs cannot act.
+    // Explicit reconnect preserves the dedicated managed sign-in home, never replays a turn.
+    if(VoiceBusy())Fail(QStringLiteral("Voice stopped; no pending audio/handoff replay. Reconnect explicitly for text or a new voice session."));
+}
