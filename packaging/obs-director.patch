+void DirectorOperatorSetup::Notify(){Controls();if(changed)changed();}
+bool DirectorOperatorSetup::CanCancel() const
+{
+    return !base.isEmpty() && !cancelling && state.value("version").isDouble() &&
+        ((valid && state.value("preparing").toBool()) || preparingLocal);
+}
+void DirectorOperatorSetup::Lost(){valid=false;password->clear();freshness.stop();status->setText("Operator setup stale/refused/unavailable; refresh, no action replay");Notify();}
+void DirectorOperatorSetup::Disconnect(){++generation;poll.stop();base.clear();state={};reading=mutating=cancelling=preparingLocal=false;Lost();status->setText("Operator client disconnected; pending native outcomes require readback");}
+void DirectorOperatorSetup::Connect(int port)
+{
+    Disconnect();if(port<1024 || port>65535 || port==4455 || port==8877 || port==8878 || port==8879)return;
+    base=QStringLiteral("http://127.0.0.1:%1").arg(port);poll.start();Read();
+}
+void DirectorOperatorSetup::Refresh(){Read();}
+void DirectorOperatorSetup::Read(){if(!base.isEmpty() && !reading)Request();}
+void DirectorOperatorSetup::CancelPreparation(){if(CanCancel())Send({{"action","arm"},{"enabled",false}},true);}
+void DirectorOperatorSetup::Send(QJsonObject command,bool cancel)
+{
+    if((!cancel && !Ready()) || (cancel && !CanCancel()))return;
+    static const QStringList allowed{"connect","disconnect","setup","arm","material_register","material_select","page_register","page_select","page_remove"};
+    if(!allowed.contains(command.value("action").toString()))return;
+    if(cancel)cancelling=true;
+    else {mutating=true;preparingLocal=command.value("action")=="arm" && command.value("enabled").toBool();}
+    const QJsonObject body{{"expected",state.value("version")},{"command",command}};
+    Request(&body,cancel);
+    command.remove("password");
+}
+void DirectorOperatorSetup::Request(const QJsonObject *body,bool cancel)
+{
+    const bool mutation=body!=nullptr;const auto serial=generation;
+    if(!mutation)reading=true;
+    Notify();QNetworkRequest request{QUrl(base+"/api/operator-setup")};request.setTransferTimeout(mutation ? 12000 : 3000);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute,QNetworkRequest::ManualRedirectPolicy);
+    request.setRawHeader("Origin",base.toUtf8());request.setHeader(QNetworkRequest::ContentTypeHeader,"application/json");
+    auto bytes=body ? QJsonDocument(*body).toJson(QJsonDocument::Compact) : QByteArray{};
+    auto reply=body ? network.post(request,bytes) : network.get(request);bytes.fill('\0');bytes.clear();
+    reply->setReadBufferSize(65537);
+    QObject::connect(reply,&QNetworkReply::readyRead,reply,[reply]{if(reply->bytesAvailable()>65536)reply->abort();});
+    QObject::connect(reply,&QNetworkReply::finished,this,[this,reply,serial,mutation,cancel]{
+        const auto bytes=reply->readAll();const auto error=reply->error();const auto http=reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();reply->deleteLater();
+        if(serial!=generation)return;
+        if(!mutation)reading=false;
+        else if(cancel)cancelling=false;
+        else {mutating=false;preparingLocal=false;}
+        const auto document=QJsonDocument::fromJson(bytes);const auto value=document.object();
+        if(error!=QNetworkReply::NoError || http!=200 || bytes.size()>65536 || !document.isObject() ||
+            value.value("build")!="expanded-director-1" || !value.value("version").isDouble() ||
+            !value.value("inputs").isArray() || !value.value("obs_connected").isBool())Lost();
+        else if(!state.value("version").isDouble() || value.value("version").toInteger()>=state.value("version").toInteger()) {
+            valid=true;freshness.start();Update(value);
+        } else Lost();
+        if(mutation && applied)applied();
+    });
+}
+void DirectorOperatorSetup::Update(const QJsonObject &value)
+{
+    state=value;
+    auto fill=[](QComboBox *box,const QJsonArray &entries,bool inputs){
+        const auto old=box->currentData();const QSignalBlocker block(box);box->clear();box->addItem(inputs ? "None" : "No selection",inputs ? QVariant(QString()) : QVariant());
+        for(const auto entry:entries){const auto item=entry.toObject();const auto id=inputs ? item.value("name") : item.value("id");box->addItem(item.value("name").toString(),id.toVariant());}
+        const auto index=box->findData(old);box->setCurrentIndex(index>=0 ? index : 0);
+    };
+    fill(camera,value.value("inputs").toArray(),true);fill(content,value.value("inputs").toArray(),true);
+    fill(materials,value.value("material_catalog").toArray(),false);fill(pages,value.value("page_catalog").toArray(),false);
+    selection->setText(QStringLiteral("Selected reference: %1\nSelected page: %2\nSelection is explicit. Registration does not load or take a page.")
+        .arg(value.value("selected_material").toObject().value("id").toString("none"),value.value("selected_page").toObject().value("id").toString("none")));
+    status->setText(QStringLiteral("Operator setup · v%1 · OBS %2 · %3")
+        .arg(value.value("version").toInteger(-1)).arg(value.value("obs_connected").toBool() ? "connected" : "disconnected")
+        .arg(value.value("preparing").toBool() ? "preparing — cancel available" : value.value("armed").toBool() ? "armed" : "disarmed"));
+    Notify();
+}
+void DirectorOperatorSetup::Controls()
+{
+    const bool ready=Ready(),linked=ready && state.value("obs_connected").toBool();
+    const bool qualified=linked && state.value("inputs_ready").toBool();
+    own->setEnabled(ready);manual->setEnabled(ready);unlink->setEnabled(linked);
+    for(auto b:{setup,fixtures,arm})b->setEnabled(qualified && !state.value("preparing").toBool());
+    disarm->setEnabled(linked && state.value("armed").toBool());
+    for(auto b:{registerMaterial,selectMaterial,registerPage,selectPage,removePage})b->setEnabled(ready);
+}
