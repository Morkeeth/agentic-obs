diff --git a/frontend/widgets/DirectorSpokenReview.hpp b/frontend/widgets/DirectorSpokenReview.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..30c09e26c091d195d406190572f001276c24ac15
--- /dev/null
+++ b/frontend/widgets/DirectorSpokenReview.hpp
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QSet>
+#include <QString>
+#include <functional>
+// Canonical user speech identifies uplink direction, NOT a person. Only the
+// local inspected-preview checkbox may Arm; speech may consume, never create it.
+class DirectorSpokenReview {
+public:
+    void Clear(){review={};version=-1;expires=0;}
+    bool Armed(qint64 now)const{return !review.isEmpty() && now<expires;}
+    bool Bound()const{return !review.isEmpty();}
+    static QRegularExpression Grammar(){return QRegularExpression("^(review|take|approve) preview ([0-9]{1,16}) revision ([0-9]{1,16})[.!?]?$",QRegularExpression::CaseInsensitiveOption);}
+    static bool Recognized(const QString &text){return Grammar().match(text.trimmed()).hasMatch();}
+    void Arm(const QString &voice,const QJsonObject &current,qint64 currentVersion,qint64 now) {
+        Clear();if(voice.isEmpty() || current.isEmpty() || currentVersion<0)return;
+        if(scopeSession!=voice || scopeReview!=current || scopeVersion!=currentVersion)seen.clear();
+        scopeSession=voice;scopeReview=current;scopeVersion=currentVersion;
+        review=current;version=currentVersion;expires=now+8000;
+    }
+    bool Consume(const QString &voice,const QString &item,const QString &text,const QJsonObject &current,qint64 currentVersion,qint64 now,
+                 const std::function<void(const QJsonObject &,qint64,bool)> &send,bool permitted=true) {
+        const auto match=Grammar().match(text.trimmed());
+        if(!match.hasMatch() || voice.isEmpty() || item.isEmpty() || item.size()>256)return false;
+        // Remember rejected privileged items in this exact scope too, so transport
+        // dedup eviction can never replay a pending/Working refusal after rearming.
+        if(!Bound() && (scopeSession!=voice || scopeReview!=current || scopeVersion!=currentVersion)) {
+            seen.clear();scopeSession=voice;scopeReview=current;scopeVersion=currentVersion;
+        }
+        const bool valid=permitted && Armed(now) && voice==scopeSession && current==review && currentVersion==version &&
+            match.captured(2).toLongLong()==current.value("payload_id").toInteger(-1) && match.captured(3).toLongLong()==currentVersion &&
+            match.captured(1).compare("review",Qt::CaseInsensitive)!=0 && !seen.contains(item) && seen.size()<256;
+        const auto frozen=review;const auto expected=version;
+        Clear(); // Retire consent BEFORE any synchronous/reentrant operator send.
+        if(seen.size()<256)seen.insert(item);
+        if(!valid)return false;
+        send(frozen,expected,match.captured(1).compare("take",Qt::CaseInsensitive)==0);return true;
+    }
+private:
+    QJsonObject review,scopeReview;
+    qint64 version=-1,expires=0,scopeVersion=-1;
+    QString scopeSession;QSet<QString> seen;
+};
diff --git a/frontend/widgets/DirectorTwitchHost.cpp b/frontend/widgets/DirectorTwitchHost.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..44e02758bb1965776e3fe71841f26802a0fd39ce
--- /dev/null
+++ b/frontend/widgets/DirectorTwitchHost.cpp
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "DirectorParticipation.hpp"
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QProcessEnvironment>
+
+DirectorTwitchHost::DirectorTwitchHost(QObject *parent):QObject(parent)
+{
+    deadline.setSingleShot(true);
+    QObject::connect(&deadline,&QTimer::timeout,this,[this] { Fail(); });
+    QObject::connect(&process,&QProcess::readyReadStandardOutput,this,[this] { Read(); });
+    QObject::connect(&process,&QProcess::readyReadStandardError,this,[this] { process.readAllStandardError(); });
+    QObject::connect(&process,&QProcess::errorOccurred,this,[this](QProcess::ProcessError) { Fail(); });
+    QObject::connect(&process,qOverload<int,QProcess::ExitStatus>(&QProcess::finished),this,[this](int,QProcess::ExitStatus) {
+        deadline.stop(); ready=false;stopping=false;buffer.clear();
+        if (!failed) status=QStringLiteral("Twitch receiver stopped — reconnect explicitly; no request replay");
+        Notify();
+    });
+}
+DirectorTwitchHost::~DirectorTwitchHost() { process.disconnect(this);process.kill();process.waitForFinished(1000); }
+void DirectorTwitchHost::Notify() { if(changed) changed(); }
+void DirectorTwitchHost::Fail()
+{
+    failed=true;ready=false;status=QStringLiteral("Twitch host unavailable/refused — not READY; details withheld, no retry");
+    deadline.stop();process.kill();Notify();
+}
+void DirectorTwitchHost::Start(const QString &project,const QString &configRoot,int port,const QJsonObject &ids,
+    const QString &service,const QString &account,bool rehearsal,bool enabled,bool authorized,bool polls)
+{
+    if (Running()) return;
+    if (!rehearsal || !enabled || !authorized) {
+        status=QStringLiteral("Twitch OFF — explicit rehearsal, receiver and controller permission required"); Notify();return;
+    }
+    if (!QFileInfo(project).isAbsolute() || !QFileInfo(configRoot).isAbsolute() ||
+        !QFileInfo(project+"/.venv/bin/python").isExecutable() || !QFileInfo(project+"/director_twitch_native.py").isFile() ||
+        service.isEmpty() || account.isEmpty() || service.size()>255 || account.size()>255 || port<1024 || port>65535 ||
+        port==4455 || port==8877 || port==8878 || port==8879) { Fail();return; }
+    const auto home=configRoot+"/twitch-host";
+    if (!QDir().mkpath(home)) { Fail();return; }
+    auto secret=credentialProvider ? credentialProvider(service,account) : QByteArray{};
+    if (secret.isEmpty() || secret.size()>4096) { secret.fill('\0');Fail();return; }
+    for (const auto c:secret) if (c<33 || c>126) { secret.fill('\0');Fail();return; }
+    const QJsonObject frame{{"protocol","director-twitch-host-1"},{"enabled",true},{"config",ids},
+        {"port",port},{"polls",polls},{"token",QString::fromLatin1(secret)}};
+    auto bytes=QJsonDocument(frame).toJson(QJsonDocument::Compact)+'\n';
+    secret.fill('\0');
+    QProcessEnvironment environment;environment.insert("PATH","/usr/bin:/bin:/usr/sbin:/sbin");
+    environment.insert("HOME",home);environment.insert("TMPDIR",home);
+    process.setProcessEnvironment(environment);process.setWorkingDirectory(project);
+    failed=false;ready=false;stopping=false;buffer.clear();
+    status=QStringLiteral("Starting read-chat host — not READY until validated session/subscription");
+    process.start(project+"/.venv/bin/python",{project+"/director_twitch_native.py","--live-host-rehearsal"});
+    Notify();
+    // QProcess's owned stdin pipe queues these bytes; no secret in arguments/env/files.
+    if (process.write(bytes)!=bytes.size()) { bytes.fill('\0');Fail();return; }
+    bytes.fill('\0');deadline.start(40000);
+}
+void DirectorTwitchHost::Stop()
+{
+    ready=false;
+    if (Running() && stopping) return;
+    stopping=Running();
+    if (Running()) { process.write("{\"command\":\"stop\"}\n");process.closeWriteChannel();deadline.start(1500); }
+    status=QStringLiteral("Twitch receiver stopping/OFF; no automatic reconnect");Notify();
+}
+void DirectorTwitchHost::SetPolls(bool enabled)
+{
+    if (Running()) {
+        const auto bytes=QJsonDocument(QJsonObject{{"command","polls"},{"enabled",enabled}}).toJson(QJsonDocument::Compact)+'\n';
+        if (process.write(bytes)!=bytes.size()) Fail();
+    }
+}
+void DirectorTwitchHost::Read()
+{
+    buffer+=process.readAllStandardOutput();
+    if(buffer.size()>4096) { Fail();return; }
+    while(buffer.contains('\n')) {
+        const auto line=buffer.left(buffer.indexOf('\n'));buffer.remove(0,line.size()+1);
+        const auto document=QJsonDocument::fromJson(line);const auto value=document.object();
+        if (!document.isObject() || value.size()!=2 || value.value("protocol")!="director-twitch-host-1") { Fail();return; }
+        const auto state=value.value("state").toString();
+        if(state=="ready") { ready=true;deadline.stop();status=QStringLiteral("Read-chat READY — validation/session/subscription accepted; no native output authority"); }
+        else if(state=="starting" || state=="not-ready") { ready=false;status=QStringLiteral("Twitch host not READY — awaiting validated read-chat session/subscription"); }
+        else if(state=="stopped" || state=="disabled") { ready=false;status=QStringLiteral("Twitch receiver OFF/stopped"); }
+        else { Fail();return; }
+        Notify();
+    }
+}
