+};
+DirectorVoiceAudio::DirectorVoiceAudio(QObject *parent):QObject(parent),device(std::make_unique<Device>())
+{
+    effects.permission=[this](auto done) {
+        const QMicrophonePermission permission;
+        const auto state=qApp->checkPermission(permission);
+        if(state==Qt::PermissionStatus::Undetermined) qApp->requestPermission(permission,this,[done](const QPermission &p){done(p.status()==Qt::PermissionStatus::Granted);});
+        else done(state==Qt::PermissionStatus::Granted);
+    };
+    effects.open=[this](auto capture,auto error) {
+        QAudioFormat format;format.setSampleRate(24000);format.setChannelCount(1);format.setSampleFormat(QAudioFormat::Int16);
+        const auto in=QMediaDevices::defaultAudioInput(),out=QMediaDevices::defaultAudioOutput();
+        if(in.isNull() || out.isNull() || !in.isFormatSupported(format) || !out.isFormatSupported(format))return false;
+        device->source=std::make_unique<QAudioSource>(in,format);
+        device->sink=std::make_unique<QAudioSink>(out,format);
+        device->source->setBufferSize(9600);device->sink->setBufferSize(24000);
+        auto stream=device->source->start();device->output=device->sink->start();
+        if(!stream || !device->output)return false;
+        QObject::connect(stream,&QIODevice::readyRead,this,[stream,capture]{
+            // Never read/allocate an unbounded device buffer.
+            capture(stream->read(9601));
+        });
+        QObject::connect(device->source.get(),&QAudioSource::stateChanged,this,[this,error](auto state){if(active && state==QtAudio::StoppedState && device->source && device->source->error()!=QtAudio::NoError)error();});
+        QObject::connect(device->sink.get(),&QAudioSink::stateChanged,this,[this,error](auto state){if(active && state==QtAudio::StoppedState && device->sink && device->sink->error()!=QtAudio::NoError)error();});
+        return device->source->error()==QtAudio::NoError && device->sink->error()==QtAudio::NoError;
+    };
+    effects.play=[this](const QByteArray &bytes){return device->sink && device->output && device->sink->bytesFree()>=bytes.size() && device->output->write(bytes)==bytes.size();};
+    effects.mute=[this](bool value){if(device->source){if(value)device->source->suspend();else device->source->resume();}};
+    effects.stop=[this]{device->Stop();};
+}
+DirectorVoiceAudio::~DirectorVoiceAudio(){Stop();}
+bool DirectorVoiceAudio::SetEffects(Effects value){if(active || opening)return false;effects=std::move(value);return true;}
+void DirectorVoiceAudio::Start()
+{
+    if(active || opening)return;
+    const auto serial=++generation;opening=true;
+    QPointer<DirectorVoiceAudio> guard(this);
+    effects.permission([guard,serial](bool granted){
+        if(!guard || serial!=guard->generation)return;
+        auto self=guard.data();self->opening=false;
+        if(!granted){self->Error();return;}
+        self->active=true;self->muted=false;
+        const bool ok=self->effects.open([guard,serial](QByteArray bytes){if(guard)guard->Capture(std::move(bytes),serial);},[guard,serial]{if(guard && serial==guard->generation)guard->Error();});
+        if(!ok){self->Error();return;}
+        if(self->changed)self->changed();
+    });
+}
+void DirectorVoiceAudio::Stop(){++generation;active=opening=muted=false;partial.fill(0);partial.clear();if(effects.stop)effects.stop();if(level)level(0);if(changed)changed();}
+void DirectorVoiceAudio::Error(){Stop();if(failed)failed();}
+void DirectorVoiceAudio::Mute(bool value){if(!active)return;muted=value;if(level)level(0);if(effects.mute)effects.mute(value);partial.fill(0);partial.clear();if(changed)changed();}
+void DirectorVoiceAudio::Capture(QByteArray bytes,quint64 serial)
+{
+    if(serial!=generation || !active || muted){bytes.fill(0);return;}
+    if(bytes.size()>9600 || partial.size()+bytes.size()>19200){bytes.fill(0);Error();return;}
+    partial+=bytes;bytes.fill(0);
+    // 100ms PCM16 LE mono chunks. A partial sample is retained only in bounded memory.
+    while(partial.size()>=4800){
+        auto chunk=partial.left(4800);partial.remove(0,4800);
+        if constexpr(QSysInfo::ByteOrder==QSysInfo::BigEndian)for(int i=0;i<chunk.size();i+=2)std::swap(chunk[i],chunk[i+1]);
+        int peak=0;
+        for(int i=0;i<chunk.size();i+=2)peak=qMax(peak,qAbs(int(qFromLittleEndian<qint16>(chunk.constData()+i))));
+        if(level)level(qMin(100,peak*100/32768));
+        const QJsonObject frame{{"data",QString::fromLatin1(chunk.toBase64())},{"sampleRate",24000},{"numChannels",1},{"samplesPerChannel",2400}};
+        chunk.fill(0);
+        if(!input || !input(frame)){Error();return;}
+    }
+}
+void DirectorVoiceAudio::Output(const QJsonObject &audio)
+{
+    if(!active)return;
+    const auto encoded=audio.value("data").toString().toLatin1();
+    const auto decoded=QByteArray::fromBase64Encoding(encoded,QByteArray::AbortOnBase64DecodingErrors);
+    auto bytes=decoded.decoded;
+    if(!decoded || encoded.size()>32000 || bytes.isEmpty() || bytes.size()>24000 || bytes.size()%2 ||
+        audio.value("sampleRate").toInt()!=24000 || audio.value("numChannels").toInt()!=1 ||
+        (!audio.value("samplesPerChannel").isNull() && audio.contains("samplesPerChannel") && audio.value("samplesPerChannel").toInt()!=bytes.size()/2)) {bytes.fill(0);Error();return;}
+    if constexpr(QSysInfo::ByteOrder==QSysInfo::BigEndian)for(int i=0;i<bytes.size();i+=2)std::swap(bytes[i],bytes[i+1]);
+    const bool ok=effects.play && effects.play(bytes);bytes.fill(0);if(!ok)Error();
+}
