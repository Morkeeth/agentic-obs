+DirectorObsProfile ParseDirectorObsProfile(const QByteArray &bytes)
+{
+    if(bytes.size()>65536)return {};
+    const auto value=QJsonDocument::fromJson(bytes).object();
+    const auto number=value.value("server_port").toDouble(-1);
+    const auto password=value.value("server_password");
+    if(!std::isfinite(number) || number!=std::floor(number) || number<1024 || number>65535 ||
+        !password.isString() || password.toString().isEmpty() || password.toString().size()>512)return {};
+    return {int(number),password.toString()};
+}
+DirectorObsProfile ReadDirectorObsProfile(const QString &knownOwnModuleFile)
+{
+    QFile file(knownOwnModuleFile);
+    if(!file.open(QIODevice::ReadOnly) || file.size()>65536)return {};
+    auto bytes=file.read(65537);auto result=ParseDirectorObsProfile(bytes);
+    bytes.fill('\0');bytes.clear();return result;
+}
