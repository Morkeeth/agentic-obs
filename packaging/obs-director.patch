+    # Qt6_DIR is <Qt prefix>/lib/cmake/Qt6 in the bundled macOS dependency.
+    # This executable is not an OBS app bundle and is never installed/bundled.
+    get_filename_component(_director_qt_prefix "${Qt6_DIR}/../../.." ABSOLUTE)
+    set_target_properties(
+      director-shell-test
+      PROPERTIES
