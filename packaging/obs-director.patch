+    rehearsal=new QCheckBox("DEFAULT OFF — opt in to live-host rehearsal",setup);rehearsal->setObjectName("twitchRehearsal");form->addWidget(rehearsal);
+    receiverEnabled=new QCheckBox("Enable owned read-chat receiver",this);receiverEnabled->setObjectName("twitchReceiverEnabled");form->addWidget(receiverEnabled);
+    start=button("Connect read-chat using selected Keychain item");layout->removeWidget(start);form->addWidget(start);stop=button("Stop read-chat receiver");
+    receiverStatus=new QLabel(host.Status(),this);receiverStatus->setTextFormat(Qt::PlainText);receiverStatus->setWordWrap(true);layout->addWidget(receiverStatus);
+    QObject::connect(requests,&QListWidget::currentRowChanged,this,[this] { Pick(); });
