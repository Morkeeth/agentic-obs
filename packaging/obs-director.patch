+        BUILD_WITH_INSTALL_RPATH FALSE
+        BUILD_RPATH "${_director_qt_prefix}/lib"
+    )
+    if(CMAKE_GENERATOR STREQUAL "Xcode")
+      # OBS sets CMAKE_SKIP_RPATH=TRUE globally for Xcode. BUILD_RPATH alone
+      # cannot override that; set this target's actual Xcode linker search path.
+      set_target_properties(
+        director-shell-test
+        # Offline, noninstalled unit executable; do not inherit app hardening.
+        # This does not change any production target, signing or entitlements.
+        PROPERTIES
+          XCODE_ATTRIBUTE_ENABLE_HARDENED_RUNTIME NO
+          XCODE_ATTRIBUTE_LD_RUNPATH_SEARCH_PATHS "\"${_director_qt_prefix}/lib\" $(inherited)"
+      )
+    endif()
+    set_tests_properties(
+      director-shell
+      PROPERTIES
+        ENVIRONMENT
+          "QT_PLUGIN_PATH=${_director_qt_prefix}/plugins;QT_QPA_PLATFORM_PLUGIN_PATH=${_director_qt_prefix}/plugins/platforms"
+    )
+    unset(_director_qt_prefix)
+  endif()
+endif()
+
+# Source-only browser slice: never compile CEF docks into this fork.
+set_property(SOURCE widgets/DirectorBrowserPolicy.cpp PROPERTY COMPILE_DEFINITIONS
