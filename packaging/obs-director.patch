+target_sources(obs-studio PRIVATE widgets/DirectorBrowserPolicy.cpp widgets/DirectorBrowserPolicy.hpp)
+if(TARGET director-shell-test)
+  target_sources(director-shell-test PRIVATE widgets/DirectorBrowserPolicy.cpp widgets/DirectorBrowserPolicy.hpp)
+endif()
+
+target_sources(obs-studio PRIVATE widgets/DirectorOperatorSetup.cpp widgets/DirectorOperatorSetup.hpp)
+if(TARGET director-shell-test)
+  target_sources(director-shell-test PRIVATE widgets/DirectorOperatorSetup.cpp widgets/DirectorOperatorSetup.hpp)
+endif()
+
+# Legacy PCM preparation is exercised only by the offline test target.
+# Production managed voice uses WebKit; do not add unused Multimedia dependencies.
+if(TARGET director-shell-test)
+  target_sources(director-shell-test PRIVATE widgets/DirectorVoiceAudio.cpp widgets/DirectorVoiceAudio.hpp)
+  target_link_libraries(director-shell-test PRIVATE Qt6::Multimedia)
+endif()
+
+# Managed voice uses the system WebKit media peer, never CEF docks or OBS audio sources.
+target_sources(obs-studio PRIVATE widgets/DirectorMediaPeer.cpp widgets/DirectorMediaPeer.hpp widgets/DirectorMediaPage.inc widgets/DirectorSpokenReview.hpp)
+if(OS_MACOS)
+  set_source_files_properties(widgets/DirectorMediaPeer_mac.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
+  target_sources(obs-studio PRIVATE widgets/DirectorMediaPeer_mac.mm)
+endif()
+if(TARGET director-shell-test)
+  target_sources(director-shell-test PRIVATE widgets/DirectorMediaPeer.cpp widgets/DirectorMediaPeer.hpp)
+  if(OS_MACOS)
+    target_sources(director-shell-test PRIVATE widgets/DirectorMediaPeer_mac.mm)
+    target_link_libraries(director-shell-test PRIVATE "$<LINK_LIBRARY:FRAMEWORK,WebKit.framework>")
+  endif()
+endif()
