+
 set_target_properties_obs(obs-studio PROPERTIES FOLDER frontend OUTPUT_NAME "$<IF:$<PLATFORM_ID:Windows>,obs64,obs>")
+
+# Opt-in shell-only Qt tests. No native OBS fixture or output backend is started.
+option(ENABLE_DIRECTOR_SHELL_TESTS "Build the fork Director shell Qt tests" OFF)
+if(ENABLE_DIRECTOR_SHELL_TESTS)
+  enable_testing()
+  find_package(Qt6 REQUIRED COMPONENTS Widgets Network Multimedia)
+  add_executable(director-shell-test tests/DirectorShellTest.cpp tests/DirectorSessionChecks.hpp tests/DirectorParticipationChecks.hpp widgets/DirectorShell.cpp widgets/DirectorShell.hpp
+    widgets/DirectorPanel.cpp widgets/DirectorPanel.hpp widgets/DirectorSession.cpp widgets/DirectorSession.hpp
+    widgets/DirectorParticipation.cpp widgets/DirectorParticipation.hpp widgets/DirectorTwitchHost.cpp widgets/DirectorTwitchKeychain.cpp)
