+    explicit DirectorSession(QObject *parent = nullptr);
+    ~DirectorSession();
+    void Connect(const QString &executable, const QString &project, int port, const QString &configRoot);
+    void Disconnect();
+    void Cancel();
+    void SignIn();
+    bool Submit(const QString &text);
+    bool StartVoice();
+    void StopVoice();
+    bool VoiceBusy() const { return voiceRequested || voiceActive; }
+    bool VoiceActive() const { return voiceActive; }
+    bool AppendAudio(const QJsonObject &) { return false; } // No PCM/text ingress into the media-only voice thread.
+    void ProvideVoiceOffer(const QString &generation,const QString &sdp);
+    void VoiceNegotiated(const QString &generation);
+    QString VoiceIdentity() const { return voiceSessionId; }
+    std::function<void(const QString &)> prepareVoice;
+    std::function<void(const QString &,const QString &)> answerVoice;
+    std::function<void(const QString &,const QString &,const QString &)> voiceUserFinal;
+    QString VoiceStatus() const { return voiceStatus; }
+    std::function<void(bool)> voiceReady;
+    std::function<void(const QJsonObject &)> voiceOutput;
+    bool Connected() const { return initialized; }
+    bool CanSubmit() const { return initialized && subscribed && !VoiceBusy() && !working && pending.isEmpty() && loginId.isEmpty(); }
+    bool CanSignIn() const { return initialized && !VoiceBusy() && !working && pending.isEmpty() && loginId.isEmpty(); }
+    bool Working() const { return working; }
+    bool Busy() const { return process.state() != QProcess::NotRunning; }
+    QString Status() const { return status; }
+    QString Transcript() const { return transcript; }
+    static QString PermissionNotice();
+    std::function<void()> changed;
+    std::function<bool(const QUrl &)> openSignIn;
+private:
+    friend void directorManagedVoiceChecks();
+    QProcess process;
+    QTimer deadline;
+    QByteArray buffer;
+    QString status = QStringLiteral("App Server disconnected; no model turn started");
+    QString transcript, work, threadId, turnId, lastFinished, loginId, queuedText;
+    QSet<QString> streamedItems;
+    bool initialized = false, subscribed = false, working = false, cancelling = false;
+    bool refreshAuth = false;
+    bool voiceRequested=false,voiceActive=false,voiceStartAccepted=false;
+    QString voiceSessionId,voiceStatus=QStringLiteral("Microphone off. Explicit opt-in starts a private managed WebRTC peer; subscription entitlement unverified.");
+    QTimer voiceDeadline;
+    void BeginRealtime();
+    void ResetVoice();
+    void MaybeVoiceReady();
+    bool voiceOfferSent=false,voiceNegotiated=false,voiceCaptureGranted=false;
+    QString voiceSdp;
+    QSet<QString> voiceItems;
+    QQueue<QString> voiceItemOrder;
+    int request = 0;
+    QHash<int,QString> pending;
+    void Fail(const QString &safeMessage);
+    void Send(const QString &method, const QJsonObject &params);
+    void Read();
+    void Handle(const QJsonObject &message);
+    void Notification(const QString &method, const QJsonObject &params);
+    void ReadAccount();
+    void StartThreadOrTurn();
+    void StartTurn();
+    void Append(const QString &text);
+    void Notify();
+};
+
+// Fixed loopback routes only. Never reads /api/state (which contains queue text).
+class DirectorController final : public QObject {
+public:
+	explicit DirectorController(QObject *parent = nullptr);
+	void Connect(int port);
+	void Disconnect();
+	void Refresh(bool background=false);
+	void Action(const QString &action);
+	void Review(const QJsonObject &identity, qint64 version, bool take);
+	QJsonObject State() const { return state; }
+	bool Ready() const { return ready && !pending; }
+    bool Fresh() const { return ready && (!pending || observing); }
