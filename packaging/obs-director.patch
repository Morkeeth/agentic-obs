+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QObject>
+#include <QByteArray>
+#include <QJsonObject>
+#include <functional>
+#include <memory>
+
+// Constructing this object never accesses devices or permission state.
+class DirectorVoiceAudio final : public QObject {
+public:
+    struct Effects {
+        std::function<void(std::function<void(bool)>)> permission;
+        std::function<bool(std::function<void(QByteArray)>,std::function<void()>)> open;
+        std::function<bool(const QByteArray &)> play;
+        std::function<void()> stop;
+        std::function<void(bool)> mute;
+    };
+    explicit DirectorVoiceAudio(QObject *parent=nullptr);
+    ~DirectorVoiceAudio();
+    bool SetEffects(Effects effects); // Inject before Start only; no device effect in tests.
+    void Start();
+    void Stop();
+    void Mute(bool muted);
+    void Output(const QJsonObject &audio);
+    bool Listening() const { return active && !muted; }
+    bool Active() const { return active; }
+    std::function<bool(const QJsonObject &)> input;
+    std::function<void()> failed;
+    std::function<void()> changed;
+    std::function<void(int)> level;
+private:
+    struct Device;
+    std::unique_ptr<Device> device;
+    Effects effects;
+    quint64 generation=0;
+    bool active=false,muted=false,opening=false;
+    QByteArray partial;
+    void Capture(QByteArray bytes,quint64 serial);
+    void Error();
+};
