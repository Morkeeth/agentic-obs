+void DirectorParticipation::SetAdvanced(bool advanced) { setup->setVisible(advanced); }
+void DirectorParticipation::Connect(const QString &value,int port)
+{
+    Disconnect();
+    if(port<1024 || port>65535 || port==4455 || port==8877 || port==8878 || port==8879)return;
+    project=value;base=QStringLiteral("http://127.0.0.1:%1").arg(port);poll.start();ReadState();
+}
+void DirectorParticipation::Disconnect()
+{
+    ++generation;poll.stop();freshness.stop();pending=valid=false;base.clear();state={};host.Stop();
+    Update({});status->setText("Participation disconnected");
+}
+void DirectorParticipation::Lost()
+{
+    valid=false;state={};selectingId.clear();selectingIntent.clear();host.Stop();
+    const QSignalBlocker block(receiverEnabled);receiverEnabled->setChecked(false);
+    Update({});status->setText("Participation unavailable/stale/refused — no optimistic success, no action replay");
+}
+bool DirectorParticipation::Authorized() const
+{
+    return valid && state.value("armed").toBool() && state.value("obs_connected").toBool() &&
+        state.value("audience_enabled").toBool() && !state.value("paused").toBool();
+}
+void DirectorParticipation::ReadState() { if(!base.isEmpty() && !pending) Request(); }
+void DirectorParticipation::Send(const QJsonObject &command)
+{
+    if(!valid || pending)return;
+    const QJsonObject body{{"expected",state.value("version")},{"command",command}};
+    Request(&body);
+}
+void DirectorParticipation::Request(const QJsonObject *body)
+{
+    pending=true;Controls();const auto serial=generation;
+    QNetworkRequest req{QUrl(base+"/api/participation")};req.setTransferTimeout(2500);
+    req.setAttribute(QNetworkRequest::RedirectPolicyAttribute,QNetworkRequest::ManualRedirectPolicy);
+    req.setRawHeader("Origin",base.toUtf8());req.setHeader(QNetworkRequest::ContentTypeHeader,"application/json");
+    auto reply=body ? network.post(req,QJsonDocument(*body).toJson(QJsonDocument::Compact)) : network.get(req);
+    reply->setReadBufferSize(65537);
+    QObject::connect(reply,&QNetworkReply::readyRead,reply,[reply] { if(reply->bytesAvailable()>65536)reply->abort(); });
+    QObject::connect(reply,&QNetworkReply::finished,this,[this,reply,serial] {
+        const auto bytes=reply->readAll();const auto error=reply->error();const auto http=reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();reply->deleteLater();
+        if(serial!=generation)return;
+        pending=false;const auto document=QJsonDocument::fromJson(bytes);const auto value=document.object();
+        if(error!=QNetworkReply::NoError || http!=200 || bytes.size()>65536 || !document.isObject() ||
+           value.value("build")!="expanded-director-1" || !value.value("version").isDouble() || !value.value("requests").isArray()) { Lost();return; }
+        valid=true;freshness.start();Update(value);
+    });
+}
+void DirectorParticipation::Pick()
+{
+    const auto item=requests->currentItem();
+    const auto row=item ? item->data(Qt::UserRole).toJsonObject() : QJsonObject{};
+    selectedId=row.value("id").toString();selectedRevision=row.value("revision").toInteger(-1);
+    selectedIntent.clear();const QSignalBlocker block(intents);intents->setCurrentIndex(-1);Controls();
+}
+void DirectorParticipation::Update(const QJsonObject &value)
+{
+    state=value;
+    const auto rows=value.value("requests").toArray();
+    const QString oldId=selectedId,oldIntent=selectedIntent;const auto oldRevision=selectedRevision;
+    const QSignalBlocker queueBlock(requests),intentBlock(intents),audienceBlock(audience),numericBlock(numeric);
+    requests->clear();intents->clear();selectedId.clear();selectedIntent.clear();selectedRevision=-1;
+    for(const auto intent:value.value("request_intents").toArray()) intents->addItem(intent.toString(),intent.toString());
+    intents->setCurrentIndex(-1);
+    QListWidgetItem *keep=nullptr;QString keepIntent;
+    for(const auto entry:rows) {
+        const auto row=entry.toObject();
+        auto item=new QListWidgetItem(row.value("text").toString(),requests);item->setData(Qt::UserRole,row);
+        const bool same=row.value("id")==oldId && row.value("revision").toInteger(-2)==oldRevision;
+        const bool justSelected=row.value("id")==selectingId && !selectingId.isEmpty() && row.value("selected")==selectingIntent;
+        if(same || justSelected) { keep=item;keepIntent=justSelected ? selectingIntent : oldIntent; }
+    }
+    selectingId.clear();selectingIntent.clear();
+    if(keep) {
+        requests->setCurrentItem(keep);const auto row=keep->data(Qt::UserRole).toJsonObject();
+        selectedId=row.value("id").toString();selectedRevision=row.value("revision").toInteger(-1);selectedIntent=keepIntent;
+        intents->setCurrentIndex(intents->findData(keepIntent));
+    }
+    audience->setChecked(value.value("audience_enabled").toBool());
+    const auto context=value.value("local_director_poll").toObject();
+    numeric->setChecked(context.value("feature_enabled").toBool());host.SetPolls(numeric->isChecked());
+    const auto definition=value.value("program_vote").toObject(),tally=value.value("poll_tally").toObject();
+    QString text=definition.value("question").toString("No taken local visual poll");
+    const auto choices=definition.value("options").toArray(),counts=tally.value("counts").toArray();
+    for(int i=0;i<choices.size();++i) text+=QStringLiteral("\n%1: %2").arg(choices[i].toString()).arg((i<counts.size() ? counts[i].toInt() : 0));
+    text+=QStringLiteral("\nEpoch %1 · %2. Counters never choose or take a visual.").arg(context.value("epoch").toString("none"),context.value("open").toBool() ? "open" : "closed/off");
+    pollStatus->setText(text);
+    if(!Authorized() && host.Running())host.Stop();
+    status->setText(valid ? QStringLiteral("Operator inbox · %1 pending · version %2").arg(rows.size()).arg(value.value("version").toInteger()) : "Participation not ready");
+    Controls();
+}
+void DirectorParticipation::Controls()
+{
+    const bool usable=valid && !pending;
+    const bool enabled=usable && state.value("audience_enabled").toBool() && !state.value("paused").toBool();
+    audience->setEnabled(usable);numeric->setEnabled(usable);
+    select->setEnabled(enabled && !selectedId.isEmpty() && !selectedIntent.isEmpty());
+    const auto item=requests->currentItem();const auto row=item ? item->data(Qt::UserRole).toJsonObject() : QJsonObject{};
+    accept->setEnabled(enabled && Authorized() && state.value("program_native").toBool() && state.value("mode")=="live" &&
+        !selectedId.isEmpty() && !selectedIntent.isEmpty() && row.value("selected")==selectedIntent);
+    reject->setEnabled(enabled && !selectedId.isEmpty());clear->setEnabled(usable && requests->count()>0);
+    const auto context=state.value("local_director_poll").toObject();
+    const bool taken=usable && context.value("taken").toBool() && !context.value("epoch").toString().isEmpty();
+    open->setEnabled(taken);close->setEnabled(taken);reset->setEnabled(taken);
+    start->setEnabled(usable && Authorized() && rehearsal->isChecked() && receiverEnabled->isChecked() && !host.Running());
+    stop->setEnabled(host.Running());
+}
