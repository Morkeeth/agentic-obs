+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <QWidget>
+#include <QJsonObject>
+#include <QNetworkAccessManager>
+#include <QTimer>
+#include <functional>
+class QLabel; class QLineEdit; class QPushButton; class QSpinBox; class QComboBox;
+struct DirectorObsProfile { int port=0; QString password; };
+// Only the selected own-app module file is passed by production wiring on a human click.
+DirectorObsProfile ParseDirectorObsProfile(const QByteArray &bytes);
+DirectorObsProfile ReadDirectorObsProfile(const QString &knownOwnModuleFile);
+class DirectorOperatorSetup final : public QWidget {
+public:
+    explicit DirectorOperatorSetup(QWidget *parent=nullptr,std::function<DirectorObsProfile()> ownProfile={});
+    void Connect(int port);
+    void Disconnect();
+    void Refresh();
+    void CancelPreparation();
+    bool Ready() const { return valid && !mutating && !cancelling; }
+    bool CanCancel() const;
+    qint64 Version() const { return state.value("version").toInteger(-1); }
+    std::function<void()> changed, applied;
+private:
+    QNetworkAccessManager network;
+    QTimer poll, freshness;
+    QString base;
+    QJsonObject state;
+    quint64 generation=0;
+    bool valid=false,reading=false,mutating=false,cancelling=false,preparingLocal=false;
+    QLabel *status,*selection;
+    QSpinBox *obsPort;
+    QLineEdit *password,*materialId,*materialName,*materialFile,*pageId,*pageName,*pageUrl;
+    QComboBox *camera,*content,*materials,*pages;
+    QPushButton *own,*manual,*unlink,*setup,*fixtures,*arm,*disarm,*registerMaterial,*selectMaterial,*registerPage,*selectPage,*removePage;
+    void Read();
+    void Send(QJsonObject command,bool cancel=false);
+    void Request(const QJsonObject *body=nullptr,bool cancel=false);
+    void Lost();
+    void Update(const QJsonObject &value);
+    void Controls();
+    void Notify();
+};
