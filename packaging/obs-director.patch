+template<typename Predicate> bool waitFor(Predicate predicate, int timeout = 2500)
+{
+	QElapsedTimer timer; timer.start();
+	while (!predicate() && timer.elapsed() < timeout) QCoreApplication::processEvents(QEventLoop::AllEvents,10);
+	return predicate();
+}
