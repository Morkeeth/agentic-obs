diff --git a/frontend/tests/DirectorManagedVoiceChecks.hpp b/frontend/tests/DirectorManagedVoiceChecks.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..62013582e143ac3d4d0e46db4c046d1ac44bfa91
--- /dev/null
+++ b/frontend/tests/DirectorManagedVoiceChecks.hpp
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "DirectorMediaPeer.hpp"
+#include "DirectorSpokenReview.hpp"
+inline QString fictionalSdp(){return "v=0\r\no=- 0 0 IN IP4 127.0.0.1\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\n";}
+inline void directorManagedVoiceChecks()
+{
+    // Native WebKit factory is REPLACED before Prepare; no WebKit/device/permission effect runs.
+    for(const auto phase:{"loaded","offer","answer","capture","wrong-origin","subframe","oversize","arbitrary","crash"}) {
+        DirectorMediaPeer peer;QUrl url;DirectorMediaPeer::Receive receive;QList<QJsonObject> commands;int stopped=0,errors=0,offers=0,answers=0;
+        check(peer.SetEffects({[&](QWidget *,const QUrl &value,auto callback){url=value;receive=callback;return true;},
+            [&](const auto &command){commands.append(command);},[&]{++stopped;}}),"inject WK effects without creating any WebKit object");
+        peer.failed=[&]{++errors;};peer.offered=[&](const auto &,const auto &){++offers;};peer.negotiated=[&](const auto &){++answers;};
+        check(!peer.Active() && commands.isEmpty(),"peer constructor starts no server/WebKit/devices");
+        check(peer.Prepare(nullptr,"generation-1"),"explicit private peer prepare binds only local ephemeral origin");
+        check(url.host()=="127.0.0.1" && url.port()>1024 && url.path().size()>32,"unguessable exact route and loopback origin");
+        if(QString(phase)=="loaded") {
+            QTcpSocket client;QByteArray reply;
+            QObject::connect(&client,&QTcpSocket::readyRead,&client,[&]{reply+=client.readAll();});
+            client.connectToHost(QHostAddress::LocalHost,url.port());check(waitFor([&]{return client.state()==QAbstractSocket::ConnectedState;}),"owned ephemeral peer HTTP fixture connects");
+            client.write("GET "+url.path().toUtf8()+" HTTP/1.1\r\nHost: 127.0.0.1:"+QByteArray::number(url.port())+"\r\n\r\n");
+            check(waitFor([&]{return reply.contains("</script>");}),"actual local HTTP serves only bundled fixed page");
+            check(reply.contains("Cache-Control: no-store") && reply.contains("Content-Security-Policy:") && !reply.contains("m=audio") && !reply.contains("CODEX_HOME"),"no SDP/config filesystem service or persistent caching");
+            QTcpSocket denied;QByteArray forbidden;
+            QObject::connect(&denied,&QTcpSocket::readyRead,&denied,[&]{forbidden+=denied.readAll();});
+            denied.connectToHost(QHostAddress::LocalHost,url.port());check(waitFor([&]{return denied.state()==QAbstractSocket::ConnectedState;}),"wrong route local fixture connected");
+            denied.write("GET /not-selected HTTP/1.1\r\nHost: 127.0.0.1:"+QByteArray::number(url.port())+"\r\n\r\n");
+            check(waitFor([&]{return denied.state()==QAbstractSocket::UnconnectedState;}) && forbidden.isEmpty(),"non-selected route refuses without any file response");
+        }
+        const QString name=phase;
+        if(name=="wrong-origin"){receive(QUrl("http://127.0.0.1:1/wrong"),true,{{"type","loaded"},{"generation",""}});check(errors==1,"wrong origin fails closed");continue;}
+        if(name=="subframe"){receive(url,false,{{"type","loaded"},{"generation",""}});check(errors==1,"subframe bridge refused");continue;}
+        if(name=="oversize"){receive(url,true,{{"type","offer"},{"generation","generation-1"},{"sdp",QString(70000,'x')}});check(errors==1,"bridge length bounded");continue;}
+        if(name=="arbitrary"){receive(url,true,{{"type","take"},{"generation","generation-1"}});check(errors==1,"no arbitrary native/controller actions in bridge");continue;}
+        receive(url,true,{{"type","loaded"},{"generation",""}});
+        check(commands.size()==1 && commands[0].value("type")=="prepare","fixed prepare only; no capture while ICE pending");
+        if(name!="loaded") {
+            receive(url,true,{{"type","offer"},{"generation","old"},{"sdp",fictionalSdp()}});check(offers==0,"old generation SDP inert");
+            receive(url,true,{{"type","offer"},{"generation","generation-1"},{"sdp",fictionalSdp()}});check(offers==1,"one valid exact generation offer");
+            if(name!="offer") {
+                peer.Answer("old",fictionalSdp());check(commands.size()==1,"retired answer cannot mutate current peer");
+                peer.Answer("generation-1",fictionalSdp());
+                receive(url,true,{{"type","negotiated"},{"generation","generation-1"}});check(answers==1 && !peer.Capturing(),"negotiation alone never captures");
+                if(name=="capture") {peer.Capture("generation-1");receive(url,true,{{"type","capturing"},{"generation","generation-1"}});check(peer.Listening(),"capture only after native authorization");peer.Mute(true);check(!peer.Listening(),"mute is explicit and independent of managed session");}
+                if(name=="crash"){receive(url,true,{{"type","error"},{"generation","generation-1"}});check(errors==1 && !peer.Active(),"renderer crash stops peer with sanitized error");}
+            }
+        }
+        peer.Stop();const auto count=commands.size();receive(url,true,{{"type","offer"},{"generation","generation-1"},{"sdp",fictionalSdp()}});
+        check(!peer.Active() && !peer.Capturing() && stopped>0 && commands.size()==count,"Stop at each phase retires generation and late callbacks");
+    }
+    {
+        DirectorMediaPeer peer;DirectorMediaPeer::Receive receive;QUrl url;int failures=0;
+        peer.failed=[&]{++failures;};
+        peer.SetEffects({[&](QWidget *,const QUrl &value,auto callback){url=value;receive=callback;return true;},[](const auto &){},[]{}});
+        check(peer.Prepare(nullptr,"retired"),"prepare old generation");const auto oldReceive=receive;const auto oldUrl=url;peer.Stop();
+        check(peer.Prepare(nullptr,"current"),"explicit new generation after Stop");
+        oldReceive(oldUrl,true,{{"type","error"},{"generation","retired"}});
+        check(peer.Active() && failures==0,"retired native delegate callback cannot poison a newer voice attempt");
+        peer.Stop();
+    }
+    for(const auto mode:{"voice-ready","voice-before","voice-refuse","voice-stale","voice-auth-loss","voice-no-identity","voice-long"}) {
+        QTemporaryDir project(QDir::tempPath()+"/director-"+mode+"-XXXXXX");QDir().mkpath(project.path()+"/.venv/bin");
+        QFile marker(project.path()+"/director_mcp.py");check(marker.open(QIODevice::WriteOnly),"voice MCP fixture");marker.close();
+        check(QFile::link(QCoreApplication::applicationFilePath(),project.path()+"/.venv/bin/python"),"fake child executable fixture");
+        DirectorSession session;int ready=0,finals=0;
+        session.prepareVoice=[&](const auto &generation){session.ProvideVoiceOffer(generation,fictionalSdp());};
+        session.answerVoice=[&](const auto &generation,const auto &sdp){check(DirectorMediaPeer::ValidSdp(sdp),"actual parser delivers bounded SDP notification");session.VoiceNegotiated(generation);};
+        session.voiceReady=[&](bool value){if(value)++ready;};
+        session.voiceUserFinal=[&](const auto &generation,const auto &item,const auto &text){check(generation==session.VoiceIdentity() && !item.isEmpty() && !text.isEmpty(),"only exact canonical user final eligible");++finals;};
+        session.Connect(QCoreApplication::applicationFilePath(),project.path(),8880,project.path()+"/runtime");check(waitFor([&]{return session.CanSubmit();}),"managed subscription read before voice");
+        check(session.StartVoice(),"explicit managed WebRTC request");const QString name=mode;
+        if(name=="voice-refuse"){check(waitFor([&]{return session.CanSubmit();}),"managed refusal retains functional text directing");check(ready==0 && finals==0 && !session.Status().contains("SYNTHETIC_PRIVATE"),"no permission before readiness or private failure echo");}
+        else if(name=="voice-stale" || name=="voice-no-identity"){check(waitFor([&]{return !session.Busy();}),"identity mismatch retires process");check(ready==0 && finals==0,"wrong identity never captures");}
+        else if(name=="voice-auth-loss"){check(waitFor([&]{return !session.Busy();}),"auth loss stops owned realtime lifecycle");check(!session.VoiceBusy(),"auth loss cannot retain microphone authority");}
+        else {check(waitFor([&]{return ready==1 && finals>=(name=="voice-long" ? 604 : 2);}),"response/SDP/started either order and consume-once canonical user item");check(!session.Submit("text must not enter active voice") && !session.AppendAudio({}),"dedicated voice thread has media-only client ingress");check(session.Transcript().isEmpty(),"no voice transcript/SDP in normal transcript");}
+        session.StopVoice();session.Disconnect();waitFor([&]{return !session.Busy();});
+        const auto key=QString::fromLatin1(QCryptographicHash::hash(QFileInfo(project.path()).canonicalFilePath().toUtf8(),QCryptographicHash::Sha256).toHex());
