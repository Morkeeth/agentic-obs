+#define DIRECTOR_BROWSER_BUILT 0
+#endif
+bool DirectorBrowserPolicy::Built() { return DIRECTOR_BROWSER_BUILT != 0; }
+QString DirectorBrowserPolicy::Status(const QStringList &arguments)
+{
+    if (!Built()) return QStringLiteral("This fork: browser sources unavailable (build disabled)");
+    if (!Enabled(true, arguments)) return QStringLiteral("This fork: browser sources OFF (local launch opt-in required)");
+    return QStringLiteral("This fork: browser sources opted in; fresh renderer readiness and human pixel review still required");
+}
